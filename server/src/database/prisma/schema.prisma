// ============================================================================
// Apex Manufacturing ERP - Database Schema
// Database Engine: PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. Enums
// ----------------------------------------------------------------------------

enum UserRole {
  TOP_MANAGEMENT
  PRODUCTION_MANAGER
  PURCHASE_MANAGER
  WAREHOUSE_MANAGER
  QUALITY_CONTROL
  PLANT_MAINTENANCE
  SALES_DISPATCH
  GATE_SECURITY
  SUBCONTRACTING
  FINANCE_ACCOUNTS
  HR_PAYROLL
  EHS_OFFICER
  IT_ADMIN
}

enum Role {
  // 13 Industrial Specialized Roles
  TOP_MANAGEMENT
  PRODUCTION_MANAGER
  PURCHASE_MANAGER
  WAREHOUSE_MANAGER
  QUALITY_CONTROL
  PLANT_MAINTENANCE
  SALES_DISPATCH
  GATE_SECURITY
  SUBCONTRACTING
  FINANCE_ACCOUNTS
  HR_PAYROLL
  EHS_OFFICER
  IT_ADMIN

  // Legacy mappings for backward compatibility
  OWNER
  PPC
  PURCHASE
  INVENTORY
  PRODUCTION_SUPERVISOR
  QC_MANAGER
  DISPATCH
  FINANCE
  HR
  ADMIN
}

enum ItemType {
  // Industrial Electronics / Reference Architecture Components
  IC
  DISPLAY
  OPTICS
  BATTERY
  SHELL
  CONNECTORS
  CONSUMABLE
  // ERP Standard Lifecycle Categories
  RAW_MATERIAL
  WIP
  FINISHED_GOOD
  SCRAP
}

enum ExpenseCategory {
  UTILITIES
  ENVIRONMENT
  INFRASTRUCTURE
  MAINTENANCE
  COMPLIANCE
  LOGISTICS
}

enum ProductionStation {
  SMT_LINE
  OPTICAL_AOI
  SCREWDRIVING
  RF_ANTENNA
  BATTERY_SEAL
  PACKAGING
}

enum SerializedUnitStatus {
  IN_PROCESS
  PASSED
  REJECTED
}

enum SubcontractStatus {
  TOLERANCE_APPROVED
  SHORTAGE_PENALTY
  SETTLED
}

enum ApprovalCategory {
  CAPEX
  PO
  CONTRACT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  CLOSED
  CANCELLED
}

enum MPSStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PRStatus {
  AUTO_GENERATED
  PENDING_APPROVAL
  APPROVED
  PO_CREATED
  REJECTED
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GatePassType {
  INWARD_PURCHASE
  OUTWARD_DISPATCH
  INTERNAL_TRANSFER
  MAINTENANCE_RETURNABLE
}

enum GatePassStatus {
  INSIDE_PLANT
  COMPLETED
  CANCELLED
}

enum InspectionDisposition {
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  QUARANTINED
}

enum RejectionReason {
  DIMENSIONAL_OUT_OF_TOLERANCE
  SURFACE_DEFECT
  WRONG_GRADE_CHEMISTRY
  CRACK_BURR
  CONTAMINATION
  DOCUMENTATION_MISSING
  TRANSIT_DAMAGE
  OTHER
}

enum WarehouseZone {
  ZONE_A_RAW_METALS
  ZONE_B_TOOLING
  ZONE_C_CLEANROOM
  ZONE_D_FASTENERS
  ZONE_Q_QUARANTINE
}

enum JobCardStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ScrapRootCause {
  TOOL_WEAR
  MATERIAL_FLAW
  OPERATOR_ERROR
  CALIBRATION_DRIFT
  POWER_FLUCTUATION
  THERMAL_DISTORTION
  OTHER
}

enum DowntimeReason {
  MECHANICAL_BREAKDOWN
  ELECTRICAL_FAULT
  TOOL_JAM_BREAKAGE
  HYDRAULIC_FAILURE
  SENSOR_FAILURE
  PLANNED_CHANGEOVER
  RAW_MATERIAL_WAIT
  OTHER
}

enum MaintenancePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MaintenanceStatus {
  DISPATCHED
  TECHNICIAN_ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FinalQCStatus {
  PASSED
  REJECTED
  CONDITIONAL
}

enum DispatchStatus {
  DRAFT
  PACKING
  READY_FOR_DISPATCH
  GATE_NOTIFIED
  TARE_PENDING
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_MATCH
  MATCHED
  VARIANCE_FLAGGED
  APPROVED
  PAID
  DISPUTED
}

enum MatchStatus {
  PERFECT_MATCH
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  BOTH_VARIANCE
  MANUALLY_OVERRIDDEN
}

enum ShiftType {
  SHIFT_A_MORNING
  SHIFT_B_EVENING
  SHIFT_C_NIGHT
  GENERAL_SHIFT
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  OVERTIME_ONLY
  ABSENT
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  DISBURSED
}

// ----------------------------------------------------------------------------
// 2. User Model
// ----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  role         UserRole  @default(IT_ADMIN)
  salary       Decimal?  @db.Decimal(12, 2) // CTC (Cost to Company)
  geoTag       String?   @db.VarChar(255)  // GPS Coordinates / Plant Geo-fence location
  shiftCheckIn DateTime? @db.Timestamptz(6) // Current shift check-in timestamp
  isActive     Boolean   @default(true)
  mfaSecret    String?   @db.VarChar(255)  // TOTP MFA Secret for GST/high-value approvals
  firstName    String?   @db.VarChar(100)
  lastName     String?   @db.VarChar(100)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  auditLogs           AuditLog[]
  authorizedApprovals HighValueApproval[] @relation("AuthorizedUser")

  @@index([role])
  @@index([email])
  @@map("users")
}

// ----------------------------------------------------------------------------
// 3. CompanySettings Model
// ----------------------------------------------------------------------------

model CompanySettings {
  id          String   @id @default(uuid()) @db.Uuid
  companyName String   @db.VarChar(200)
  gstin       String   @db.VarChar(20)
  config      Json     // JSONB configuration (plant shifts, fiscal year, currency, tax rules)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("company_settings")
}

// ----------------------------------------------------------------------------
// 4. Dynamic ItemMaster Model (with JSONB customAttrs)
// ----------------------------------------------------------------------------

model ItemMaster {
  id              String   @id @default(uuid()) @db.Uuid
  sku             String?  @unique @db.VarChar(50) // 15-digit SKU / Industrial Part Number
  code            String   @unique @db.VarChar(50) // Unique item code / SKU
  name            String   @db.VarChar(200)
  category        ItemType @default(RAW_MATERIAL)
  uom             String   @default("PCS") @db.VarChar(20) // PCS, KG, MTR, LTR, BOX
  unit            String?  @db.VarChar(20)
  customAttrs     Json     // Dynamic JSONB attributes (grade, specs, dimensions, heat number, tolerances)
  currentStock    Decimal  @default(0) @db.Decimal(14, 4)
  stockQty        Decimal? @db.Decimal(14, 4)
  minStockQty     Decimal  @default(0) @db.Decimal(14, 4)
  minReorderLevel Decimal? @db.Decimal(14, 4)
  unitCost        Decimal  @default(0) @db.Decimal(14, 4)
  costPerPiece    Decimal? @db.Decimal(14, 4) // Live feedable rate
  sellingPrice    Decimal  @default(0) @db.Decimal(14, 4)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  bomsAsFinished       BillOfMaterials[]          @relation("FinishedItemBOM")
  bomComponents        BOMItem[]                  @relation("ComponentItem")
  bomItemParents       BOMItem[]                  @relation("ParentItemBOMItems")
  serializedUnits      SerializedUnit[]           @relation("SerializedUnits")
  salesOrderItems      SalesOrderItem[]
  mpsPlans             MasterProductionSchedule[]
  purchaseRequisitions PurchaseRequisition[]
  poItems              PurchaseOrderItem[]
  inspectionReports    MaterialInspectionReport[]
  warehouseBins        WarehouseBin[]
  jobCards             JobCard[]
  jobCardMaterials     JobCardMaterial[]
  finalInspections     FinalQCInspection[]
  dispatchCartons      DispatchCarton[]
  invoiceItems         VendorInvoiceItem[]

  @@index([code])
  @@index([sku])
  @@index([category])
  @@index([isActive])
  @@map("item_master")
}

// ----------------------------------------------------------------------------
// 5. BillOfMaterials & BOMItem Models (Multi-Level Recipes with scrapRate)
// ----------------------------------------------------------------------------

model BillOfMaterials {
  id             String   @id @default(uuid()) @db.Uuid
  bomNumber      String   @unique @db.VarChar(50) // e.g. "BOM-PMP-100-MAIN"
  name           String   @db.VarChar(200)
  version        String   @default("1.0") @db.VarChar(20)
  finishedItemId String   @db.Uuid
  level          Int      @default(1) // Level 1: Finished Good, Level 2: Sub-Assembly, etc.
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  finishedItem   ItemMaster                 @relation("FinishedItemBOM", fields: [finishedItemId], references: [id], onDelete: Restrict)
  components     BOMItem[]                  @relation("ParentBOM")
  subAssemblies  BOMItem[]                  @relation("SubAssemblyBOM")
  mpsPlans       MasterProductionSchedule[]

  @@index([finishedItemId])
  @@index([bomNumber])
  @@map("bill_of_materials")
}

model BOMItem {
  id                String   @id @default(uuid()) @db.Uuid
  bomId             String?  @db.Uuid
  parentItemId      String?  @db.Uuid
  componentItemId   String   @db.Uuid
  
  // Multi-level reference: if this component is itself an assembly linking to a child recipe
  subBomId          String?  @db.Uuid
  
  quantity          Decimal  @default(1) @db.Decimal(14, 4)
  requiredPerUnit   Decimal? @db.Decimal(14, 4) // Required component quantity per finished unit
  scrapRate         Decimal  @default(0) @db.Decimal(5, 2) // Scrap rate percentage (e.g. 2.50%)
  scrapTolerancePct Decimal? @db.Decimal(5, 2) // Component scrap tolerance percentage
  uom               String   @default("PCS") @db.VarChar(20)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  bom               BillOfMaterials? @relation("ParentBOM", fields: [bomId], references: [id], onDelete: Cascade)
  parentItem        ItemMaster?      @relation("ParentItemBOMItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem     ItemMaster       @relation("ComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)
  subBom            BillOfMaterials? @relation("SubAssemblyBOM", fields: [subBomId], references: [id], onDelete: SetNull)

  @@index([bomId])
  @@index([parentItemId])
  @@index([componentItemId])
  @@map("bom_items")
}

// ----------------------------------------------------------------------------
// 6. SalesOrder & SalesOrderItem Models
// ----------------------------------------------------------------------------

model SalesOrder {
  id           String           @id @default(uuid()) @db.Uuid
  orderNumber  String           @unique @db.VarChar(50) // e.g. "SO-2026-001"
  customerName String           @db.VarChar(200)
  customerPo   String?          @db.VarChar(100)
  orderDate    DateTime         @default(now()) @db.Timestamptz(6)
  deliveryDate DateTime         @db.Timestamptz(6)
  status       SalesOrderStatus @default(DRAFT)
  totalAmount  Decimal          @default(0) @db.Decimal(14, 4)
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  items        SalesOrderItem[]
  mpsPlans     MasterProductionSchedule[]
  dispatchOrders DispatchOrder[]

  @@index([orderNumber])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  salesOrderId String     @db.Uuid
  itemId       String     @db.Uuid
  quantity     Decimal    @db.Decimal(14, 4)
  unitPrice    Decimal    @db.Decimal(14, 4)
  totalPrice   Decimal    @db.Decimal(14, 4)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item         ItemMaster @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([itemId])
  @@map("sales_order_items")
}

// ----------------------------------------------------------------------------
// 7. Master Production Schedule (MPS) & MRP Purchase Requisitions
// ----------------------------------------------------------------------------

model MasterProductionSchedule {
  id             String      @id @default(uuid()) @db.Uuid
  planNumber     String      @unique @db.VarChar(50) // e.g. "MPS-2026-001"
  salesOrderId   String?     @db.Uuid
  finishedItemId String      @db.Uuid
  bomId          String?     @db.Uuid
  plannedQty     Decimal     @db.Decimal(14, 4)
  producedQty    Decimal     @default(0) @db.Decimal(14, 4)
  startDate      DateTime    @db.Timestamptz(6)
  dueDate        DateTime    @db.Timestamptz(6)
  status         MPSStatus   @default(PLANNED)
  priority       String      @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  salesOrder     SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  finishedItem   ItemMaster       @relation(fields: [finishedItemId], references: [id], onDelete: Restrict)
  bom            BillOfMaterials? @relation(fields: [bomId], references: [id], onDelete: SetNull)
  requisitions   PurchaseRequisition[]
  jobCards       JobCard[]

  @@index([planNumber])
  @@index([status])
  @@index([startDate, dueDate])
  @@map("master_production_schedules")
}

model PurchaseRequisition {
  id             String               @id @default(uuid()) @db.Uuid
  prNumber       String               @unique @db.VarChar(50) // e.g. "PR-2026-001"
  itemId         String               @db.Uuid
  mpsPlanId      String?              @db.Uuid
  quantity       Decimal              @db.Decimal(14, 4)
  status         PRStatus             @default(AUTO_GENERATED)
  reason         String               @db.VarChar(255) // "MRP Shortage Trigger for MPS-2026-001"
  requiredBy     DateTime             @db.Timestamptz(6)
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  item           ItemMaster           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  mpsPlan        MasterProductionSchedule? @relation(fields: [mpsPlanId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]

  @@index([prNumber])
  @@index([status])
  @@index([itemId])
  @@map("purchase_requisitions")
}

// ----------------------------------------------------------------------------
// 8. Vendor & Purchase Order Models
// ----------------------------------------------------------------------------

model Vendor {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(50) // e.g. "VEND-001"
  name               String          @db.VarChar(200)
  gstin              String?         @db.VarChar(20)
  email              String?         @db.VarChar(255)
  phone              String?         @db.VarChar(50)
  paymentTerms       String?         @default("NET 30") @db.VarChar(50)
  onTimeDeliveryRate Decimal         @default(96.5) @db.Decimal(5, 2) // percentage
  rating             Decimal         @default(4.8) @db.Decimal(3, 2)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  purchaseOrders     PurchaseOrder[]
  invoices           VendorInvoice[]

  @@index([code])
  @@index([isActive])
  @@map("vendors")
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  poNumber             String              @unique @db.VarChar(50) // e.g. "PO-2026-001"
  vendorId             String              @db.Uuid
  requisitionId        String?             @db.Uuid
  orderDate            DateTime            @default(now()) @db.Timestamptz(6)
  expectedDeliveryDate DateTime            @db.Timestamptz(6)
  status               PurchaseOrderStatus @default(PENDING)
  subtotal             Decimal             @default(0) @db.Decimal(14, 4)
  gstRate              Decimal             @default(18.0) @db.Decimal(5, 2) // percentage (e.g. 18%)
  gstAmount            Decimal             @default(0) @db.Decimal(14, 4)
  totalAmount          Decimal             @default(0) @db.Decimal(14, 4)
  paymentTerms         String?             @db.VarChar(100)
  notes                String?             @db.Text
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)

  vendor               Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  gatePasses           GatePass[]
  inspectionReports    MaterialInspectionReport[]
  invoices             VendorInvoice[]
  threeWayMatches      ThreeWayMatch[]

  @@index([poNumber])
  @@index([status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id           String        @id @default(uuid()) @db.Uuid
  poId         String        @db.Uuid
  itemId       String        @db.Uuid
  quantity     Decimal       @db.Decimal(14, 4)
  receivedQty  Decimal       @default(0) @db.Decimal(14, 4)
  unitRate     Decimal       @db.Decimal(14, 4)
  gstRate      Decimal       @default(18.0) @db.Decimal(5, 2)
  gstAmount    Decimal       @default(0) @db.Decimal(14, 4)
  totalAmount  Decimal       @default(0) @db.Decimal(14, 4)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item         ItemMaster    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([poId])
  @@index([itemId])
  @@map("purchase_order_items")
}

// ----------------------------------------------------------------------------
// 9. Gate Pass & Weighbridge Logistics
// ----------------------------------------------------------------------------

model GatePass {
  id               String         @id @default(uuid()) @db.Uuid
  passNumber       String         @unique @db.VarChar(50) // e.g. "GP-2026-0089"
  passType         GatePassType   @default(INWARD_PURCHASE)
  status           GatePassStatus @default(INSIDE_PLANT)

  // Vehicle & Driver Logistics
  vehicleNumber    String         @db.VarChar(50) // e.g. "MH-12-RN-4821"
  driverName       String         @db.VarChar(100)
  driverPhone      String?        @db.VarChar(50)
  driverLicense    String?        @db.VarChar(50)
  transporterName  String?        @db.VarChar(150)

  // Weighbridge Gross / Tare / Net Weight
  grossWeightKg    Decimal        @db.Decimal(12, 2)
  tareWeightKg     Decimal?       @db.Decimal(12, 2)
  netWeightKg      Decimal?       @db.Decimal(12, 2)

  // Linked Purchase Order / Documents
  purchaseOrderId  String?        @db.Uuid
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  invoiceNumber    String?        @db.VarChar(100)
  ewayBillNumber   String?        @db.VarChar(100)

  // Gate Security Timestamps
  inwardTime       DateTime       @default(now()) @db.Timestamptz(6)
  outwardTime      DateTime?      @db.Timestamptz(6)

  // Security Operator info
  gateNumber       String         @default("Gate 1 (North)") @db.VarChar(50)
  securityOfficer  String         @default("Officer S. Rathore") @db.VarChar(100)
  securityRemarks  String?        @db.Text

  // Digital Verification & QR
  verificationCode String         @unique @db.VarChar(64)

  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  dispatchOrders   DispatchOrder[]

  @@index([passNumber])
  @@index([vehicleNumber])
  @@index([status])
  @@index([inwardTime])
  @@index([purchaseOrderId])
  @@map("gate_passes")
}

// ----------------------------------------------------------------------------
// 10. Quality Inspection (MIR), GRN & Debit Notes
// ----------------------------------------------------------------------------

model MaterialInspectionReport {
  id                   String                @id @default(uuid()) @db.Uuid
  mirNumber            String                @unique @db.VarChar(50) // e.g. "MIR-2026-0129"
  purchaseOrderId      String?               @db.Uuid
  itemId               String                @db.Uuid
  batchNumber          String                @db.VarChar(100) // Supplier Heat/Batch #
  heatNumber           String?               @db.VarChar(100)

  // Inspection Quantities
  inspectedQty         Decimal               @db.Decimal(14, 4)
  passedQty            Decimal               @default(0) @db.Decimal(14, 4)
  rejectedQty          Decimal               @default(0) @db.Decimal(14, 4)
  uom                  String                @default("PCS") @db.VarChar(20)

  // Disposition & Defect Specs
  disposition          InspectionDisposition @default(ACCEPTED)
  rejectionReason      RejectionReason?
  defectDetails        String?               @db.Text
  specsComparison      Json?                 // JSONB: expected vs actual tolerances

  // Automated ERP Outcomes
  grnNumber            String?               @unique @db.VarChar(50) // Auto-generated on pass
  debitNoteNumber      String?               @unique @db.VarChar(50) // Auto-generated on reject
  debitNoteAmount      Decimal?              @default(0) @db.Decimal(14, 4)
  quarantineLocation   String?               @db.VarChar(100) // e.g. "Zone Q - Bay Q-01"

  inspectorName        String                @default("QC Inspector M. Joshi") @db.VarChar(100)
  notes                String?               @db.Text
  inspectedAt          DateTime              @default(now()) @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)

  purchaseOrder        PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  item                 ItemMaster            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([mirNumber])
  @@index([purchaseOrderId])
  @@index([itemId])
  @@index([disposition])
  @@map("material_inspection_reports")
}

// ----------------------------------------------------------------------------
// 11. Warehouse Bin & Rack Allocation (Putaway & Lot Matrix)
// ----------------------------------------------------------------------------

model WarehouseBin {
  id              String        @id @default(uuid()) @db.Uuid
  binCode         String        @unique @db.VarChar(50) // e.g. "A-01-B1"
  zone            WarehouseZone @default(ZONE_A_RAW_METALS)
  aisle           String        @db.VarChar(10)
  rack            String        @db.VarChar(10)
  shelf           String        @db.VarChar(10)
  binNumber       String        @db.VarChar(10)

  // Storage Allocations
  itemId          String?       @db.Uuid
  batchNumber     String?       @db.VarChar(100)
  currentQty      Decimal       @default(0) @db.Decimal(14, 4)
  maxCapacity     Decimal       @default(1000) @db.Decimal(14, 4)
  uom             String        @default("PCS") @db.VarChar(20)

  isQuarantine    Boolean       @default(false)
  isOccupied      Boolean       @default(false)
  lastPutawayAt   DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  item            ItemMaster?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([binCode])
  @@index([zone])
  @@index([itemId])
  @@map("warehouse_bins")
}

// ----------------------------------------------------------------------------
// 12. Production Floor Execution (Job Cards, Live Output, Scrap & Downtime)
// ----------------------------------------------------------------------------

model JobCard {
  id              String         @id @default(uuid()) @db.Uuid
  jobCardNumber   String         @unique @db.VarChar(50) // e.g. "JC-2026-0881"
  mpsPlanId       String?        @db.Uuid
  itemId          String         @db.Uuid
  productionLine  String         @db.VarChar(100) // e.g. "Line 3 - CNC Machining Cell"
  batchNumber     String         @db.VarChar(100) // e.g. "BATCH-2026-0922"
  shift           String         @default("Shift A (Morning)") @db.VarChar(50)
  status          JobCardStatus  @default(IN_PROGRESS)
  targetQty       Decimal        @db.Decimal(14, 4)
  completedQty    Decimal        @default(0) @db.Decimal(14, 4)
  scrapQty        Decimal        @default(0) @db.Decimal(14, 4)
  uom             String         @default("PCS") @db.VarChar(20)
  cycleTimeSec    Int            @default(45) // standard cycle time per part
  supervisorName  String         @default("Supervisor R. Verma") @db.VarChar(100)
  operatorName    String?        @db.VarChar(100)
  notes           String?        @db.Text
  startedAt       DateTime       @default(now()) @db.Timestamptz(6)
  completedAt     DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  item            ItemMaster                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  mpsPlan         MasterProductionSchedule? @relation(fields: [mpsPlanId], references: [id], onDelete: SetNull)
  operations      JobCardOperation[]
  materials       JobCardMaterial[]
  scrapLogs       ScrapLog[]

  @@index([jobCardNumber])
  @@index([status])
  @@index([itemId])
  @@index([productionLine])
  @@map("job_cards")
}

model JobCardOperation {
  id                String    @id @default(uuid()) @db.Uuid
  jobCardId         String    @db.Uuid
  sequence          Int       @default(10) // 10, 20, 30, 40...
  operationName     String    @db.VarChar(150) // "CNC Turning & Facing", "Deep Hole Drilling"
  workstation       String    @db.VarChar(100) // "CNC-03 Haas ST-20"
  operatorName      String    @db.VarChar(100) // "Operator K. Shinde"
  cycleTimeSeconds  Int       @default(45)
  completedQty      Decimal   @default(0) @db.Decimal(14, 4)
  scrapQty          Decimal   @default(0) @db.Decimal(14, 4)
  status            String    @default("IN_PROGRESS") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED
  startedAt         DateTime? @db.Timestamptz(6)
  completedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  jobCard           JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  scrapLogs         ScrapLog[]

  @@index([jobCardId])
  @@index([sequence])
  @@map("job_card_operations")
}

model JobCardMaterial {
  id              String     @id @default(uuid()) @db.Uuid
  jobCardId       String     @db.Uuid
  itemId          String     @db.Uuid
  batchNumber     String?    @db.VarChar(100)
  heatNumber      String?    @db.VarChar(100)
  requiredQty     Decimal    @db.Decimal(14, 4)
  consumedQty     Decimal    @default(0) @db.Decimal(14, 4)
  uom             String     @default("PCS") @db.VarChar(20)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  jobCard         JobCard    @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  item            ItemMaster @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([jobCardId])
  @@index([itemId])
  @@map("job_card_materials")
}

model ScrapLog {
  id             String         @id @default(uuid()) @db.Uuid
  jobCardId      String         @db.Uuid
  operationId    String?        @db.Uuid
  defectQty      Decimal        @db.Decimal(14, 4)
  rootCause      ScrapRootCause @default(TOOL_WEAR)
  defectDetails  String?        @db.Text
  loggedBy       String         @default("Supervisor") @db.VarChar(100)
  loggedAt       DateTime       @default(now()) @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  jobCard        JobCard           @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  operation      JobCardOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([jobCardId])
  @@index([rootCause])
  @@map("scrap_logs")
}

model MachineDowntime {
  id                    String              @id @default(uuid()) @db.Uuid
  machineCode           String              @db.VarChar(50) // e.g. "CNC-03"
  machineName           String              @db.VarChar(150) // e.g. "Haas ST-20 Lathe"
  productionLine        String              @db.VarChar(100) // e.g. "Line 3 - CNC Machining Cell"
  reason                DowntimeReason      @default(MECHANICAL_BREAKDOWN)
  rootCauseDetails      String?             @db.Text
  startedAt             DateTime            @default(now()) @db.Timestamptz(6)
  endedAt               DateTime?           @db.Timestamptz(6)
  durationMinutes       Int?
  status                String              @default("ACTIVE") @db.VarChar(30) // ACTIVE, RESOLVED
  autoDispatched        Boolean             @default(false)
  maintenanceTicketId   String?             @db.VarChar(50)
  loggedBy              String              @default("Supervisor R. Verma") @db.VarChar(100)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  maintenanceDispatches MaintenanceDispatch[]

  @@index([machineCode])
  @@index([status])
  @@index([startedAt])
  @@map("machine_downtimes")
}

model MaintenanceDispatch {
  id                  String              @id @default(uuid()) @db.Uuid
  ticketNumber        String              @unique @db.VarChar(50) // e.g. "MNT-2026-0042"
  downtimeId          String?             @db.Uuid
  machineCode         String              @db.VarChar(50)
  priority            MaintenancePriority @default(CRITICAL)
  faultDescription    String              @db.Text
  status              MaintenanceStatus   @default(DISPATCHED)
  assignedTechnician  String              @default("Senior Tech A. Kulkarni") @db.VarChar(100)
  dispatchedAt        DateTime            @default(now()) @db.Timestamptz(6)
  acknowledgedAt      DateTime?           @db.Timestamptz(6)
  resolvedAt          DateTime?           @db.Timestamptz(6)
  resolutionNotes     String?             @db.Text
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)

  downtime            MachineDowntime?    @relation(fields: [downtimeId], references: [id], onDelete: SetNull)

  @@index([ticketNumber])
  @@index([status])
  @@index([machineCode])
  @@map("maintenance_dispatches")
}

// ----------------------------------------------------------------------------
// 13. Finished Goods QC (CoC) & Dispatch Outward (Packing Lists & Gate Outward)
// ----------------------------------------------------------------------------

model FinalQCInspection {
  id                   String        @id @default(uuid()) @db.Uuid
  certificateNumber    String        @unique @db.VarChar(50) // e.g. "COC-2026-0881"
  jobCardId            String?       @db.Uuid
  itemId               String        @db.Uuid
  batchNumber          String        @db.VarChar(100)
  heatNumber           String?       @db.VarChar(100)
  
  // Inspection Quantities
  inspectedQty         Decimal       @db.Decimal(14, 4)
  passedQty            Decimal       @default(0) @db.Decimal(14, 4)
  rejectedQty          Decimal       @default(0) @db.Decimal(14, 4)
  uom                  String        @default("PCS") @db.VarChar(20)
  status               FinalQCStatus @default(PASSED)

  // Quality Technical Checklists & Specs
  checklist            Json          // JSONB: dimensionalTolerance, surfaceFinishRa, hardnessHrc, packaging, labeling
  targetWarehouseBin   String?       @db.VarChar(50) // e.g. "C-01-B1" (FG Bay)
  stockUpdatedToFG     Boolean       @default(false)

  // Digital Sign-Off
  inspectorName        String        @default("QC Lead V. Sharma") @db.VarChar(100)
  digitalSignatureHash String        @db.VarChar(128)
  signedAt             DateTime      @default(now()) @db.Timestamptz(6)
  notes                String?       @db.Text
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  item                 ItemMaster    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([certificateNumber])
  @@index([status])
  @@index([itemId])
  @@index([batchNumber])
  @@map("final_qc_inspections")
}

model DispatchOrder {
  id                   String          @id @default(uuid()) @db.Uuid
  dispatchNumber       String          @unique @db.VarChar(50) // e.g. "DSP-2026-0112"
  salesOrderId         String?         @db.Uuid
  customerName         String          @db.VarChar(200)
  customerPo           String?         @db.VarChar(100)
  destination          String          @db.VarChar(255)
  transporterName      String?         @db.VarChar(150)
  vehicleNumber        String          @db.VarChar(50)
  driverName           String          @db.VarChar(100)
  driverPhone          String?         @db.VarChar(50)
  ewayBillNumber       String?         @db.VarChar(50) // 12-digit Indian GST e-Way Bill
  status               DispatchStatus  @default(PACKING)
  totalCartons         Int             @default(1)
  totalGrossWeightKg   Decimal         @default(0) @db.Decimal(12, 2)
  totalNetWeightKg     Decimal         @default(0) @db.Decimal(12, 2)

  // Outward Gate Integration
  gatePassId           String?         @db.Uuid
  signedOffBy          String?         @db.VarChar(100)
  signedOffAt          DateTime?       @db.Timestamptz(6)
  gateNotifiedAt       DateTime?       @db.Timestamptz(6)
  notes                String?         @db.Text
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  salesOrder           SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  gatePass             GatePass?       @relation(fields: [gatePassId], references: [id], onDelete: SetNull)
  cartons              DispatchCarton[]

  @@index([dispatchNumber])
  @@index([status])
  @@index([ewayBillNumber])
  @@index([vehicleNumber])
  @@map("dispatch_orders")
}

model DispatchCarton {
  id              String        @id @default(uuid()) @db.Uuid
  dispatchOrderId String        @db.Uuid
  cartonNumber    String        @db.VarChar(50) // e.g. "CTN-2026-0112-01"
  itemId          String        @db.Uuid
  batchNumber     String        @db.VarChar(100)
  quantity        Decimal       @db.Decimal(14, 4)
  uom             String        @default("PCS") @db.VarChar(20)
  grossWeightKg   Decimal       @db.Decimal(10, 2)
  netWeightKg     Decimal       @db.Decimal(10, 2)
  barcode         String        @db.VarChar(100)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  dispatchOrder   DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  item            ItemMaster    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([dispatchOrderId])
  @@index([cartonNumber])
  @@index([itemId])
  @@map("dispatch_cartons")
}

// ----------------------------------------------------------------------------
// 15. Finance: Vendor Invoices & 3-Way Reconciliation
// ----------------------------------------------------------------------------

model VendorInvoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @db.VarChar(50) // e.g. "INV-VEND-2026-081"
  vendorId        String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  grnNumber       String?       @db.VarChar(50) // Linked Goods Receipt Note
  invoiceDate     DateTime      @db.Timestamptz(6)
  dueDate         DateTime      @db.Timestamptz(6)
  subtotal        Decimal       @default(0) @db.Decimal(14, 4)
  gstAmount       Decimal       @default(0) @db.Decimal(14, 4)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 4)
  status          InvoiceStatus @default(PENDING_MATCH)
  varianceAmount  Decimal       @default(0) @db.Decimal(14, 4)
  varianceReason  String?       @db.Text
  notes           String?       @db.Text
  approvedBy      String?       @db.VarChar(100)
  approvedAt      DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lineItems       VendorInvoiceItem[]
  threeWayMatches ThreeWayMatch[]

  @@index([invoiceNumber])
  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("vendor_invoices")
}

model VendorInvoiceItem {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @db.Uuid
  itemId         String        @db.Uuid
  billedQuantity Decimal       @db.Decimal(14, 4)
  billedUnitRate Decimal       @db.Decimal(14, 4)
  billedGstRate  Decimal       @default(18.0) @db.Decimal(5, 2)
  billedAmount   Decimal       @db.Decimal(14, 4)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  invoice        VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item           ItemMaster    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([itemId])
  @@map("vendor_invoice_items")
}

model ThreeWayMatch {
  id                  String      @id @default(uuid()) @db.Uuid
  invoiceId           String      @db.Uuid
  purchaseOrderId     String      @db.Uuid
  grnNumber           String?     @db.VarChar(50)
  matchStatus         MatchStatus @default(PERFECT_MATCH)
  qtyVariance         Decimal     @default(0) @db.Decimal(14, 4)
  priceVariance       Decimal     @default(0) @db.Decimal(14, 4)
  totalVariance       Decimal     @default(0) @db.Decimal(14, 4)
  hasToleranceBreach  Boolean     @default(false)
  debitNoteGenerated  Boolean     @default(false)
  debitNoteNumber     String?     @db.VarChar(50)
  debitNoteAmount     Decimal?    @default(0) @db.Decimal(14, 4)
  reconciledBy        String?     @db.VarChar(100)
  reconciledAt        DateTime?   @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(6)

  invoice             VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([purchaseOrderId])
  @@index([matchStatus])
  @@map("three_way_matches")
}

// ----------------------------------------------------------------------------
// 16. HR & Workforce Management (Shifts, Attendance & Payroll)
// ----------------------------------------------------------------------------

model Employee {
  id                 String             @id @default(uuid()) @db.Uuid
  employeeCode       String             @unique @db.VarChar(50) // e.g. "EMP-101"
  name               String             @db.VarChar(150)
  email              String?            @db.VarChar(255)
  phone              String?            @db.VarChar(50)
  department         String             @db.VarChar(100) // e.g. "CNC Machining", "Assembly", "Quality"
  designation        String             @db.VarChar(100) // e.g. "Senior CNC Machinist", "Floor Lead"
  baseSalaryMonthly  Decimal            @db.Decimal(12, 2)
  hourlyRate         Decimal            @db.Decimal(10, 2)
  overtimeMultiplier Decimal            @default(1.5) @db.Decimal(4, 2)
  bankAccount        String?            @db.VarChar(50)
  panNumber          String?            @db.VarChar(20)
  pfNumber           String?            @db.VarChar(50)
  esiNumber          String?            @db.VarChar(50)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  attendances        AttendanceRecord[]
  payrollRecords     PayrollRecord[]

  @@index([employeeCode])
  @@index([department])
  @@index([isActive])
  @@map("employees")
}

model ShiftRoster {
  id                  String    @id @default(uuid()) @db.Uuid
  shiftType           ShiftType @unique
  shiftName           String    @db.VarChar(100) // "Morning Shift A", "Evening Shift B", "Night Shift C"
  startTime           String    @db.VarChar(10) // "06:00"
  endTime             String    @db.VarChar(10) // "14:30"
  breakDurationMin    Int       @default(30)
  nightShiftAllowance Decimal   @default(0) @db.Decimal(10, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  @@map("shift_rosters")
}

model AttendanceRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  employeeId         String           @db.Uuid
  date               DateTime         @db.Date
  shiftType          ShiftType        @default(SHIFT_A_MORNING)
  clockIn            DateTime?        @db.Timestamptz(6)
  clockOut           DateTime?        @db.Timestamptz(6)
  regularHours       Decimal          @default(0) @db.Decimal(5, 2)
  overtimeHours      Decimal          @default(0) @db.Decimal(5, 2)
  status             AttendanceStatus @default(PRESENT)
  biometricDeviceId  String?          @db.VarChar(50)
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([shiftType])
  @@index([status])
  @@map("attendance_records")
}

model PayrollRecord {
  id                 String        @id @default(uuid()) @db.Uuid
  employeeId         String        @db.Uuid
  monthYear          String        @db.VarChar(20) // e.g. "2026-10"
  baseSalary         Decimal       @db.Decimal(12, 2)
  regularHoursTotal  Decimal       @default(0) @db.Decimal(8, 2)
  overtimeHoursTotal Decimal       @default(0) @db.Decimal(8, 2)
  overtimePay        Decimal       @default(0) @db.Decimal(12, 2)
  shiftAllowances    Decimal       @default(0) @db.Decimal(12, 2)
  grossEarnings      Decimal       @default(0) @db.Decimal(12, 2)
  pfDeduction        Decimal       @default(0) @db.Decimal(10, 2) // 12% statutory PF
  esiDeduction       Decimal       @default(0) @db.Decimal(10, 2) // 0.75% statutory ESI
  profTaxDeduction   Decimal       @default(200) @db.Decimal(10, 2) // PT standard
  totalDeductions    Decimal       @default(0) @db.Decimal(12, 2)
  netPayable         Decimal       @default(0) @db.Decimal(12, 2)
  status             PayrollStatus @default(DRAFT)
  approvedBy         String?       @db.VarChar(100)
  disbursedAt        DateTime?     @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([monthYear])
  @@index([status])
  @@map("payroll_records")
}

// ----------------------------------------------------------------------------
// 17. Immutable Audit Trail & System Security Logs
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  userEmail   String?  @db.VarChar(255)
  userName    String?  @db.VarChar(150)
  userRole    UserRole?
  action      String   @db.VarChar(50)  // CREATE, UPDATE, DELETE, STATUS_CHANGE, APPROVE, DISPATCH, REJECT, PRICE_OVERRIDE
  entity      String   @db.VarChar(100) // SalesOrder, WorkOrder, BillOfMaterials, VendorInvoice, GatePass, ItemMaster, etc.
  entityId    String   @db.VarChar(100) // Primary identifier / Document number
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.Text
  changes     Json?    // JSONB: { before: {...}, after: {...}, diffSummary: [...] }
  metadata    Json?    // Extra contextual tags (plantId, warehouseId, notes)
  recordHash  String?  @db.VarChar(128) // SHA-256 tamper-evident integrity hash
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 18. Costing & Plant Overhead Models
// ----------------------------------------------------------------------------

model PlantExpense {
  id            String          @id @default(uuid()) @db.Uuid
  title         String          @db.VarChar(200)
  category      ExpenseCategory @default(UTILITIES)
  monthlyAmount Decimal         @db.Decimal(14, 2)
  iconKey       String?         @db.VarChar(50)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@map("plant_expenses")
}

model CostingParameter {
  id                           String   @id @default(uuid()) @db.Uuid
  targetSellingPrice           Decimal  @db.Decimal(14, 2)
  monthlyProductionTargetVolume Decimal @db.Decimal(14, 2)
  rawCostPerUnitCache          Decimal  @db.Decimal(14, 4)
  overheadPerUnitCache         Decimal  @db.Decimal(14, 4)
  createdAt                    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(6)

  @@map("costing_parameters")
}

// ----------------------------------------------------------------------------
// 19. Shop Floor & Serialized IMEI Tracking
// ----------------------------------------------------------------------------

model SerializedUnit {
  id             String               @id @default(uuid()) @db.Uuid
  serialNumber   String               @unique @db.VarChar(50) // 15-digit IMEI or UID
  productId      String               @db.Uuid
  currentStation ProductionStation    @default(SMT_LINE)
  status         SerializedUnitStatus @default(IN_PROCESS)
  historyLogs    Json                 // JSONB history logs of station handoffs & validation
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  product        ItemMaster           @relation("SerializedUnits", fields: [productId], references: [id], onDelete: Restrict)

  @@index([serialNumber])
  @@index([productId])
  @@index([currentStation])
  @@index([status])
  @@map("serialized_units")
}

model TelemetryLog {
  id              String   @id @default(uuid()) @db.Uuid
  machineId       String   @db.VarChar(100)
  lineId          String   @db.VarChar(100)
  reflowTemp      Float?   // Celsius
  torqueNm        Float?   // Newton-meters
  oeeAvailability Float?   // Percentage 0-100
  oeePerformance  Float?   // Percentage 0-100
  oeeQuality      Float?   // Percentage 0-100
  timestamp       DateTime @default(now()) @db.Timestamptz(6)

  @@index([machineId])
  @@index([lineId])
  @@index([timestamp])
  @@map("telemetry_logs")
}

// ----------------------------------------------------------------------------
// 20. Financial, Subcontracting & Credit Models
// ----------------------------------------------------------------------------

model CustomerCredit {
  id                String   @id @default(uuid()) @db.Uuid
  customerName      String   @unique @db.VarChar(200)
  creditLimit       Decimal  @db.Decimal(14, 2)
  outstandingAmount Decimal  @default(0) @db.Decimal(14, 2)
  isLocked          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([customerName])
  @@map("customer_credits")
}

model SubcontractChallan {
  id              String            @id @default(uuid()) @db.Uuid
  challanNo       String            @unique @db.VarChar(50)
  vendorName      String            @db.VarChar(200)
  sentQty         Decimal           @db.Decimal(14, 4)
  returnedQty     Decimal           @default(0) @db.Decimal(14, 4)
  allowedScrapQty Decimal           @default(0) @db.Decimal(14, 4)
  actualScrapQty  Decimal           @default(0) @db.Decimal(14, 4)
  status          SubcontractStatus @default(TOLERANCE_APPROVED)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  @@index([challanNo])
  @@index([vendorName])
  @@index([status])
  @@map("subcontract_challans")
}

model DebitNote {
  id                String   @id @default(uuid()) @db.Uuid
  dnNumber          String   @unique @db.VarChar(50) // e.g. DN-2026-0001
  vendorId          String   @db.VarChar(100)
  lotRef            String   @db.VarChar(100)
  amount            Decimal  @db.Decimal(14, 2)
  reason            String   @db.Text
  rtvChallanNo      String?  @db.VarChar(50)
  apDeductionStatus String   @default("AP_PENDING") @db.VarChar(50)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([dnNumber])
  @@index([vendorId])
  @@index([lotRef])
  @@map("debit_notes")
}

model HighValueApproval {
  id                 String           @id @default(uuid()) @db.Uuid
  refNo              String           @unique @db.VarChar(50)
  category           ApprovalCategory @default(CAPEX)
  amount             Decimal          @db.Decimal(14, 2)
  isMfaVerified      Boolean          @default(false)
  authorizedByUserId String?          @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  authorizedBy       User?            @relation("AuthorizedUser", fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@index([refNo])
  @@index([category])
  @@index([authorizedByUserId])
  @@map("high_value_approvals")
}

