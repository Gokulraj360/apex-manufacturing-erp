enum POStatus {
  DRAFT
  PENDING_SUPERVISOR
  PENDING_EXECUTIVE_APPROVAL
  APPROVED
  REJECTED
  FULFILLED
}

enum ContractStatus {
  DRAFT
  PENDING_REVIEW
  EXECUTED
  EXPIRED
  TERMINATED
}

enum PayrollStatus {
  CALCULATED
  PENDING_EXECUTIVE_SIGNOFF
  APPROVED
  DISBURSED
  AUDITED
}

enum ProductionLineHealth {
  OPTIMAL
  OPERATIONAL_WITH_WARNINGS
  MAINTENANCE_REQUIRED
  CRITICAL_DOWNTIME
  OFFLINE
}

enum MetricType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

// ==================== FINANCE MODULE ENUMS ====================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum VendorBillStatus {
  DRAFT
  PENDING_MATCHING
  MATCHED
  DISCREPANCY
  APPROVED
  SCHEDULED_FOR_PAYMENT
  PAID
  CANCELLED
}

enum ThreeWayMatchStatus {
  PENDING
  EXACT_MATCH
  PRICE_DISCREPANCY
  QTY_DISCREPANCY
  TOTAL_DISCREPANCY
}

enum ClientInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  REFUNDED
}

enum TaxReportType {
  GST_RETURN
  CORPORATE_TAX
  WITHHOLDING_TAX
}

enum TaxReportStatus {
  DRAFT
  FILED
  AUDITED
}

// ==================== PRODUCTION MODULE ENUMS ====================

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  PAUSED
  QUALITY_HOLD
  COMPLETED
  CANCELLED
}

enum ProductionBatchStatus {
  QUEUED
  ACTIVE
  INTERRUPTED
  COMPLETED
  REJECTED
}

enum RequisitionStatus {
  REQUESTED
  ISSUED
  CONSUMED
  REJECTED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MaintenanceStatus {
  REPORTED
  IN_TRIAGE
  TECHNICIAN_ASSIGNED
  RESOLVED
  CLOSED
}

enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
  COSMETIC
}

// ==================== WAREHOUSE MODULE ENUMS ====================

enum StockCategory {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOODS
  CONSUMABLE
  SPARE_PART
}

enum ChallanStatus {
  DRAFT
  PICKING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum CycleCountStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RECONCILED
}

enum AdjustmentReason {
  CYCLE_COUNT_VARIANCE
  SCRAP_WRITE_OFF
  DAMAGED_TRANSIT
  SUPPLIER_SHORTAGE_CORRECTION
  INTERNAL_RECLASSIFICATION
}

// ==================== CORE MODELS ====================

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  firstName        String
  lastName         String
  isActive         Boolean           @default(true)
  roleId           String
  role             Role              @relation(fields: [roleId], references: [id])
  
  auditLogs        AuditLog[]
  approvedPOs      PurchaseOrder[]   @relation("ExecutivePOApprovals")
  approvedPayrolls PayrollRecord[]   @relation("ExecutivePayrollApprovals")
  signedContracts  ClientContract[]  @relation("ExecutiveContractSignatures")
  employeeProfile  Employee?
  userAccount      UserAccount?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([email])
  @@index([roleId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystemRole    Boolean          @default(false)
  hierarchyLevel  Int              @default(100)
  
  users           User[]
  permissions     RolePermission[]
  functionPermissions RoleFunctionPermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  resource    String
  description String?
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedBy    String?

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleFunctionPermission {
  id           String   @id @default(uuid())
  roleName     String   // e.g. 'super_admin', 'finance', 'production', 'warehouse', etc.
  functionKey  String   // e.g. 'FUNC_PAYROLL_DISBURSE', 'FUNC_WORK_ORDER_EDIT', etc.
  category     String   @default("GENERAL") // e.g. 'EXECUTIVE', 'FINANCE', 'PRODUCTION', etc.
  functionName String?  // User-friendly display title
  isAllowed    Boolean  @default(true)
  configuredBy String   @default("Super Admin") // Admin user who last configured
  notes        String?  // Optional audit remark
  
  roleRefId    String?
  role         Role?    @relation(fields: [roleRefId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roleName, functionKey])
  @@index([roleName])
  @@index([functionKey])
  @@index([category])
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  entity         String
  entityId       String?
  details        String
  changes        Json?
  ipAddress      String?
  userAgent      String?
  severity       AuditSeverity @default(INFO)
  tamperChecksum String
  
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([severity])
}

model FinancialMetric {
  id               String     @id @default(uuid())
  metricDate       DateTime   @default(now())
  periodType       MetricType @default(MONTHLY)
  revenue          Decimal    @db.Decimal(18, 2)
  cogs             Decimal    @db.Decimal(18, 2)
  operatingExpense Decimal    @db.Decimal(18, 2)
  netProfit        Decimal    @db.Decimal(18, 2)
  cashInflow       Decimal    @db.Decimal(18, 2)
  cashOutflow      Decimal    @db.Decimal(18, 2)
  freeCashFlow     Decimal    @db.Decimal(18, 2)
  taxProvision     Decimal    @db.Decimal(18, 2)
  taxLiability     Decimal    @db.Decimal(18, 2)
  currency         String     @default("USD")
  notes            String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([metricDate])
}

model ProductionLineStatus {
  id              String               @id @default(uuid())
  lineNumber      Int                  @unique
  lineName        String
  currentSKU      String?
  targetUnits     Int                  @default(0)
  actualUnits     Int                  @default(0)
  uptimeMinutes   Int                  @default(0)
  downtimeMinutes Int                  @default(0)
  healthStatus    ProductionLineHealth @default(OPTIMAL)
  defectRatePpm   Decimal              @default(0.0) @db.Decimal(8, 2)
  activeOperators Int                  @default(0)
  downtimeReason  String?
  lastMaintenance DateTime?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([healthStatus])
}

model PurchaseOrder {
  id             String          @id @default(uuid())
  poNumber       String          @unique
  supplierName   String
  totalAmount    Decimal         @db.Decimal(18, 2)
  currency       String          @default("USD")
  isHighValue    Boolean         @default(false)
  status         POStatus        @default(DRAFT)
  items          Json
  justification  String?
  
  approvedById   String?
  approvedBy     User?           @relation("ExecutivePOApprovals", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  vendorBills    VendorBill[]    @relation("POVendorBills")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([isHighValue])
}

model ClientContract {
  id             String         @id @default(uuid())
  contractNumber String         @unique
  clientName     String
  totalValue     Decimal        @db.Decimal(18, 2)
  currency       String         @default("USD")
  status         ContractStatus @default(DRAFT)
  effectiveDate  DateTime
  expiryDate     DateTime
  deliverables   Json?
  
  signedById     String?
  signedBy       User?          @relation("ExecutiveContractSignatures", fields: [signedById], references: [id])
  signedAt       DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

model PayrollRecord {
  id             String        @id @default(uuid())
  periodMonth    Int
  periodYear     Int
  totalGross     Decimal       @db.Decimal(18, 2)
  totalNet       Decimal       @db.Decimal(18, 2)
  taxDeductions  Decimal       @db.Decimal(18, 2)
  benefitsTotal  Decimal       @db.Decimal(18, 2)
  employeeCount  Int
  status         PayrollStatus @default(CALCULATED)
  
  approvedById   String?
  approvedBy     User?         @relation("ExecutivePayrollApprovals", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNotes  String?
  disbursedAt    DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([periodMonth, periodYear])
  @@index([status])
}

// ==================== FINANCE & ACCOUNTING MODELS ====================

model ChartOfAccount {
  id              String            @id @default(uuid())
  accountCode     String            @unique
  accountName     String
  accountType     AccountType
  description     String?
  currency        String            @default("USD")
  currentBalance  Decimal           @default(0.0) @db.Decimal(18, 2)
  isActive        Boolean           @default(true)
  isHeader        Boolean           @default(false)
  
  parentAccountId String?
  parentAccount   ChartOfAccount?   @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  subAccounts     ChartOfAccount[]  @relation("AccountHierarchy")

  journalLines    JournalEntryLine[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([accountType])
  @@index([isActive])
}

model AccountingPeriod {
  id             String         @id @default(uuid())
  periodName     String         @unique
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean        @default(false)
  closedAt       DateTime?
  closedById     String?
  
  journalEntries JournalEntry[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isClosed])
}

model JournalEntry {
  id                 String             @id @default(uuid())
  entryNumber        String             @unique
  entryDate          DateTime           @default(now())
  memo               String
  status             JournalEntryStatus @default(DRAFT)
  totalDebit         Decimal            @default(0.0) @db.Decimal(18, 2)
  totalCredit        Decimal            @default(0.0) @db.Decimal(18, 2)
  
  accountingPeriodId String
  accountingPeriod   AccountingPeriod   @relation(fields: [accountingPeriodId], references: [id])

  createdById        String?
  postedById         String?
  postedAt           DateTime?
  
  sourceModule       String?
  sourceReferenceId  String?

  lines              JournalEntryLine[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([accountingPeriodId])
  @@index([entryDate])
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  
  debit          Decimal        @default(0.0) @db.Decimal(18, 2)
  credit         Decimal        @default(0.0) @db.Decimal(18, 2)
  description    String?
  entityRef      String?

  createdAt      DateTime       @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

model VendorBill {
  id                   String              @id @default(uuid())
  billNumber           String              @unique
  vendorName           String
  vendorInvoiceNo      String
  poId                 String?
  purchaseOrder        PurchaseOrder?      @relation("POVendorBills", fields: [poId], references: [id])
  grnNumber            String?
  
  invoiceDate          DateTime
  dueDate              DateTime
  subtotal             Decimal             @db.Decimal(18, 2)
  taxAmount            Decimal             @default(0.0) @db.Decimal(18, 2)
  totalAmount          Decimal             @db.Decimal(18, 2)
  paidAmount           Decimal             @default(0.0) @db.Decimal(18, 2)
  
  status               VendorBillStatus    @default(PENDING_MATCHING)
  matchStatus          ThreeWayMatchStatus @default(PENDING)
  discrepancyNotes     String?
  
  poAmountExpected     Decimal?            @db.Decimal(18, 2)
  grnQuantityReceived  Int?
  billedQuantity       Int?
  
  scheduledPaymentDate DateTime?
  ledgerEntries        VendorLedger[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([matchStatus])
  @@index([vendorName])
}

model VendorLedger {
  id              String      @id @default(uuid())
  vendorName      String
  transactionDate DateTime    @default(now())
  transactionType String
  referenceNo     String
  debit           Decimal     @default(0.0) @db.Decimal(18, 2)
  credit          Decimal     @default(0.0) @db.Decimal(18, 2)
  runningBalance  Decimal     @db.Decimal(18, 2)
  
  vendorBillId    String?
  vendorBill      VendorBill? @relation(fields: [vendorBillId], references: [id])
  notes           String?

  createdAt       DateTime    @default(now())

  @@index([vendorName])
  @@index([transactionDate])
}

model ClientInvoice {
  id                String              @id @default(uuid())
  invoiceNumber     String              @unique
  clientName        String
  issueDate         DateTime            @default(now())
  dueDate           DateTime
  subtotal          Decimal             @db.Decimal(18, 2)
  taxRatePercentage Decimal             @default(18.0) @db.Decimal(5, 2)
  taxAmount         Decimal             @db.Decimal(18, 2)
  totalAmount       Decimal             @db.Decimal(18, 2)
  paidAmount        Decimal             @default(0.0) @db.Decimal(18, 2)
  status            ClientInvoiceStatus @default(ISSUED)
  paymentTerms      String              @default("NET_30")
  lineItems         Json
  lastFollowUpDate  DateTime?
  
  creditNotes       CreditNote[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([clientName])
}

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  clientInvoiceId  String
  clientInvoice    ClientInvoice    @relation(fields: [clientInvoiceId], references: [id])
  issueDate        DateTime         @default(now())
  amount           Decimal          @db.Decimal(18, 2)
  reason           String
  status           CreditNoteStatus @default(ISSUED)

  createdAt        DateTime         @default(now())

  @@index([clientInvoiceId])
}

model PayrollAccountingRecord {
  id                    String        @id @default(uuid())
  periodMonth           Int
  periodYear            Int
  headcount             Int
  grossSalary           Decimal       @db.Decimal(18, 2)
  taxWithheld           Decimal       @db.Decimal(18, 2)
  employeeBenefits      Decimal       @db.Decimal(18, 2)
  employerProvidentFund Decimal       @db.Decimal(18, 2)
  netPayable            Decimal       @db.Decimal(18, 2)
  status                PayrollStatus @default(CALCULATED)
  glJournalEntryId      String?
  disbursedDate         DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([periodMonth, periodYear])
  @@index([status])
}

model TaxReport {
  id               String          @id @default(uuid())
  taxPeriod        String
  reportType       TaxReportType   @default(GST_RETURN)
  taxableSales     Decimal         @db.Decimal(18, 2)
  outputTax        Decimal         @db.Decimal(18, 2)
  taxablePurchases Decimal         @db.Decimal(18, 2)
  inputTaxCredit   Decimal         @db.Decimal(18, 2)
  netTaxPayable    Decimal         @db.Decimal(18, 2)
  status           TaxReportStatus @default(DRAFT)
  filedAt          DateTime?
  notes            String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([taxPeriod])
  @@index([reportType])
}

// ==================== PRODUCTION & SHOP FLOOR MODELS ====================

model BillOfMaterials {
  id                      String            @id @default(uuid())
  sku                     String            @unique
  name                    String
  version                 String            @default("1.0")
  description             String?
  components              Json
  blueprintUrl            String?
  blueprintSpecifications Json?

  routings                AssemblyRouting[]
  workOrders              WorkOrder[]

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([sku])
}

model AssemblyRouting {
  id                 String          @id @default(uuid())
  bomId              String
  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  
  stepNumber         Int
  stationName        String
  instruction        String
  cycleTimeMinutes   Int
  toolingRequired    String?
  qualityCheckpoints Json?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([bomId, stepNumber])
}

model WorkOrder {
  id                  String                @id @default(uuid())
  orderNumber         String                @unique
  bomId               String
  bom                 BillOfMaterials       @relation(fields: [bomId], references: [id])
  
  targetQuantity      Int
  completedQuantity   Int                   @default(0)
  scrapQuantity       Int                   @default(0)
  status              WorkOrderStatus       @default(PLANNED)
  
  startDate           DateTime?
  dueDate             DateTime
  completedDate       DateTime?
  
  assignedLineNumber  Int?
  assignedSupervisor  String?
  milestones          Json?
  
  batches             ProductionBatch[]
  requisitions        MaterialRequisition[]
  scrapLogs           ScrapLog[]
  wipStocks           WorkInProgressStock[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([bomId])
}

model ProductionBatch {
  id             String                @id @default(uuid())
  batchNumber    String                @unique
  workOrderId    String
  workOrder      WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  plannedUnits   Int
  producedUnits  Int                   @default(0)
  defectiveUnits Int                   @default(0)
  status         ProductionBatchStatus @default(QUEUED)
  
  startTime      DateTime?
  endTime        DateTime?
  currentStation String?
  operatorId     String?
  notes          String?

  scrapLogs      ScrapLog[]

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@index([workOrderId])
}

model MaterialRequisition {
  id                String            @id @default(uuid())
  requisitionNumber String            @unique
  workOrderId       String
