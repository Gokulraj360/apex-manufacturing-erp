  WEIGHING_SCALE
  IOT_SENSOR
  LABEL_PRINTER
  TOUCH_TERMINAL
  PLC_CONTROLLER
  NETWORK_GATEWAY
}

enum HardwareDeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
  CALIBRATION_DUE
}

enum BackupType {
  FULL_DATABASE
  INCREMENTAL
  SCHEMA_ONLY
  TRANSACTION_LOGS
  DISASTER_RECOVERY_SNAPSHOT
}

enum BackupStatus {
  SUCCESSFUL
  IN_PROGRESS
  FAILED
  VERIFIED
  RESTORING
}

enum SecurityIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_INVESTIGATION
  RESOLVED
  CLOSED
}

model UserAccount {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int       @default(0)
  isLocked              Boolean   @default(false)
  lockedUntil           DateTime?
  forcePasswordChange   Boolean   @default(false)
  passwordLastChangedAt DateTime?
  allowedIpRanges       String?   // e.g. '10.0.0.0/8,192.168.1.0/24'
  sessionTimeoutMinutes Int       @default(60)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([isLocked])
}

model SystemRolePermission {
  id          String    @id @default(uuid())
  roleName    String
  resource    String    // 'PRODUCTION', 'WAREHOUSE', 'FINANCE', 'LOGISTICS', 'HR', 'SYSTEM_ADMIN'
  action      String    // 'CREATE', 'READ', 'UPDATE', 'DELETE', 'EXECUTE', 'APPROVE'
  isAllowed   Boolean   @default(true)
  scope       String    @default("ALL") // 'ALL', 'OWN_DEPARTMENT', 'ASSIGNED_PLANT'
  grantedBy   String?
  expiresAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([roleName, resource, action])
  @@index([roleName])
  @@index([resource])
}

model HardwareIntegration {
  id                    String               @id @default(uuid())
  deviceCode            String               @unique // e.g. 'HW-SCN-001', 'HW-SCALE-002', 'HW-IOT-VIB-01'
  deviceName            String
  deviceType            HardwareDeviceType   @default(BARCODE_SCANNER)
  ipAddress             String?
  macAddress            String?
  portNumber            Int?
  communicationProtocol String               @default("MQTT") // MQTT, REST_API, MODBUS_TCP, SERIAL_RS232, WEBSOCKET
  location              String               // e.g. "Main Gate Weighbridge Pit 1", "Assembly Station 4"
  status                HardwareDeviceStatus @default(ONLINE)
  lastHeartbeat         DateTime?
  firmwareVersion       String?
  configPayload         Json?
  calibrationDueDate    DateTime?

  deviceLogs            NetworkDeviceLog[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([deviceCode])
  @@index([deviceType])
  @@index([status])
  @@index([location])
}

model NetworkDeviceLog {
  id                 String              @id @default(uuid())
  hardwareId         String
  hardware           HardwareIntegration @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  latencyMs          Int?
  packetLossRate     Decimal?            @db.Decimal(5, 2)
  bandwidthUsageKbps Int?
  eventDescription   String
  isAlertTriggered   Boolean             @default(false)

  createdAt          DateTime            @default(now())

  @@index([hardwareId])
  @@index([createdAt])
  @@index([isAlertTriggered])
}

model BackupLog {
  id                    String       @id @default(uuid())
  backupId              String       @unique // e.g. 'BKP-2026-10-07-001'
  backupType            BackupType   @default(FULL_DATABASE)
  storageDestination   String       // e.g. 's3://apex-erp-vault/pg_prod_backup.tar.gz'
  fileSizeBytes         BigInt       @default(0)
  durationSeconds       Int          @default(0)
  checksumSha256        String?
  status                BackupStatus @default(SUCCESSFUL)
  initiatedBy           String       @default("SYSTEM_CRON")
  restorationVerifiedAt DateTime?

  createdAt             DateTime     @default(now())

  @@index([backupId])
  @@index([backupType])
  @@index([status])
  @@index([createdAt])
}

model SecurityAuditLog {
  id                    String                  @id @default(uuid())
  eventType             String                  // 'FAILED_LOGIN', 'BRUTE_FORCE_BLOCK', 'UNAUTHORIZED_API_ACCESS', 'FIREWALL_RULE_TRIGGER', 'PRIVILEGE_ESCALATION'
  sourceIp              String
  userAgent             String?
  severity              SecurityIncidentSeverity @default(LOW)
  details               String
  isResolved            Boolean                 @default(false)
  resolvedBy            String?
  mitigationActionTaken String?

  createdAt             DateTime                @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

model SupportTicket {
  id                 String                @id @default(uuid())
  ticketNumber       String                @unique // e.g. 'TCK-2026-0042'
  title              String
  description        String
  category           String                // 'HARDWARE_TERMINAL', 'NETWORK_CONNECTIVITY', 'BARCODE_PRINTER', 'USER_ACCESS', 'IOT_SENSOR'
  priority           SupportTicketPriority @default(MEDIUM)
  status             SupportTicketStatus   @default(OPEN)
  reportedByName     String
  assignedToEngineer String?
  affectedLocation   String?
  resolutionNotes    String?
  resolvedAt         DateTime?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([ticketNumber])
  @@index([priority])
  @@index([status])
  @@index([category])
}

// =========================================================================
// EQUIPMENT RELIABILITY & ASSET MANAGEMENT MODULE
// =========================================================================

enum AssetStatus {
  OPERATIONAL
  DEGRADED
  UNDER_MAINTENANCE
  BREAKDOWN_STOPPAGE
  DECOMMISSIONED
}

enum AssetCategory {
  CNC_MACHINING
  INJECTION_MOLDING
  ASSEMBLY_ROBOT
  CONVEYOR_SYSTEM
  HYDRAULIC_PRESS
  FURNACE_HEATER
  PACKAGING_LINE
  UTILITY_COMPRESSOR
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL_BOTTLENECK
}

enum MaintenanceInterval {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

enum MaintenanceScheduleType {
  ROUTINE_INSPECTION
  LUBRICATION
  CALIBRATION
  ELECTRICAL_INSPECTION
  MECHANICAL_OVERHAUL
  FILTER_REPLACEMENT
  SAFETY_AUDIT
}

enum MaintenanceScheduleStatus {
  SCHEDULED
  DUE
  OVERDUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BreakdownSeverity {
  MINOR
  MODERATE
  CRITICAL
  CATASTROPHIC
}

enum BreakdownTicketStatus {
  REPORTED
  IN_DIAGNOSIS
  WAITING_FOR_PARTS
  UNDER_REPAIR
  RESOLVED
  VERIFIED
}

enum ToolCribRequisitionStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
  RETURNED
}

enum AssetLifecycleEventType {
  COMMISSIONING
  PREVENTIVE_MAINTENANCE
  BREAKDOWN_REPAIR
  CALIBRATION
  RELOCATION
  DECOMMISSION
}

model MachineAsset {
  id                   String                 @id @default(uuid())
  assetTag             String                 @unique // e.g. 'AST-CNC-001'
  assetName            String
  category             AssetCategory          @default(CNC_MACHINING)
  serialNumber         String
  modelNumber          String
  manufacturer         String
  facilityLocation     String
  powerRatingKw        Decimal?               @db.Decimal(10, 2)
  operatingVoltage     String?
  installationDate     DateTime
  warrantyExpiryDate   DateTime?
  status               AssetStatus            @default(OPERATIONAL)
  criticality          AssetCriticality       @default(HIGH)
  totalOperatingHours  Decimal                @default(0) @db.Decimal(12, 2)
  mtbfHours            Decimal?               @db.Decimal(10, 2) // Mean Time Between Failures
  mttrHours            Decimal?               @db.Decimal(10, 2) // Mean Time To Repair
  manualDocumentUrl    String?
  specifications       Json?

  maintenanceSchedules MaintenanceSchedule[]
  breakdownTickets     BreakdownTicket[]
  lifecycleLogs        AssetLifecycleLog[]
  workstationAssignments DepartmentWorkstationAssignment[]
  machineCertChecks       MachineCertificationCheck[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([assetTag])
  @@index([category])
  @@index([status])
  @@index([facilityLocation])
  @@index([criticality])
}

model MaintenanceSchedule {
  id                      String                    @id @default(uuid())
  scheduleCode            String                    @unique // e.g. 'PMS-CNC01-M01'
  assetId                 String
  asset                   MachineAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title                   String
  scheduleType            MaintenanceScheduleType   @default(ROUTINE_INSPECTION)
  interval                MaintenanceInterval       @default(MONTHLY)
  intervalHours           Int?
  status                  MaintenanceScheduleStatus @default(SCHEDULED)
  lastPerformedAt         DateTime?
  nextDueDate             DateTime
  estimatedDurationHours  Decimal                   @default(2.0) @db.Decimal(6, 2)
  assignedTechnician      String?
  checklistItems          Json?
  notes                   String?

  toolCribRequisitions    ToolCribRequisition[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([scheduleCode])
  @@index([assetId])
  @@index([status])
  @@index([nextDueDate])
  @@index([scheduleType])
}

model BreakdownTicket {
  id                    String                @id @default(uuid())
  ticketNumber          String                @unique // e.g. 'BDK-2026-0104'
  assetId               String
  asset                 MachineAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedBy            String
  assignedTechnician    String?
  severity              BreakdownSeverity     @default(MODERATE)
  status                BreakdownTicketStatus @default(REPORTED)
  failureCategory       String                // e.g. 'SPINDLE_BEARING', 'HYDRAULIC_LEAK', 'SERVO_FAULT'
  symptomDescription    String
  rootCause             String?
  correctiveActionTaken String?
  breakdownStartedAt    DateTime              @default(now())
  repairCompletedAt     DateTime?
  downtimeHours         Decimal?              @db.Decimal(10, 2)
  repairCostEstimate    Decimal?              @db.Decimal(12, 2)

  partsRequisitions     ToolCribRequisition[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([ticketNumber])
  @@index([assetId])
  @@index([status])
  @@index([severity])
  @@index([breakdownStartedAt])
}

model SparePart {
  id                      String                @id @default(uuid())
  partCode                String                @unique // e.g. 'SPR-BRG-6208'
  partName                String
  category                String                // 'BEARINGS', 'SEALS', 'HYDRAULICS', 'PNEUMATICS', 'ELECTRICAL_SENSORS'
  compatibleMachineModels String?
  currentStock            Int                   @default(0)
  minimumThreshold        Int                   @default(5)
  unitOfMeasure           String                @default("PCS")
  unitCost                Decimal               @db.Decimal(12, 2)
  cribBinLocation         String                // e.g. 'Rack B, Bin 12'
  supplierName            String?
  leadTimeDays            Int                   @default(7)

  toolCribRequisitions    ToolCribRequisition[]

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([partCode])
  @@index([category])
  @@index([currentStock])
}

model ToolCribRequisition {
  id                    String                    @id @default(uuid())
  requisitionNumber     String                    @unique // e.g. 'REQ-SP-2026-0042'
  sparePartId           String
  sparePart             SparePart                 @relation(fields: [sparePartId], references: [id])
  breakdownTicketId     String?
  breakdownTicket       BreakdownTicket?          @relation(fields: [breakdownTicketId], references: [id], onDelete: SetNull)
  maintenanceScheduleId String?
  maintenanceSchedule   MaintenanceSchedule?      @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)
  quantity              Int                       @default(1)
  status                ToolCribRequisitionStatus @default(REQUESTED)
  requestedBy           String
  approvedBy            String?
  issuedAt              DateTime?
  purposeNotes          String?

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([requisitionNumber])
  @@index([sparePartId])
  @@index([breakdownTicketId])
  @@index([maintenanceScheduleId])
  @@index([status])
}

model AssetLifecycleLog {
  id                      String                  @id @default(uuid())
  assetId                 String
  asset                   MachineAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType               AssetLifecycleEventType @default(PREVENTIVE_MAINTENANCE)
  eventTitle              String
  eventDescription        String
  costIncurred            Decimal                 @default(0.0) @db.Decimal(12, 2)
  downtimeIncurredMinutes Int                     @default(0)
  performedBy             String

  recordedAt              DateTime                @default(now())

  @@index([assetId])
  @@index([eventType])
  @@index([recordedAt])
}

