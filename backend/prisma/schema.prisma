  CUSTOMER_FEEDBACK_RECORDED
  DEPARTMENT_WORKER_DEPLOYED
  DEPARTMENT_ATTENDANCE_LOGGED
  DEPARTMENT_OVERTIME_APPROVED
  DEPARTMENT_OUTPUT_RECORDED
  MACHINE_CERTIFICATION_VERIFIED
