  PO_APPROVAL
  CONTRACT_APPROVAL
  SYSTEM_CONFIG_CHANGE
  SECURITY_BREACH_DETECTED
  JOURNAL_ENTRY_POST
  PERIOD_CLOSE
  VENDOR_BILL_MATCH
  PAYMENT_DISBURSED
  INVOICE_GENERATED
  TAX_REPORT_FILED
  WORK_ORDER_START
  WORK_ORDER_COMPLETE
  BATCH_STATUS_UPDATE
  SCRAP_LOGGED
  MAINTENANCE_TICKET_RAISED
  REQUISITION_ISSUED
  GRN_GENERATED
  MATERIAL_ISSUED
