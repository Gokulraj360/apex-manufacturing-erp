model CadModel {
  id                   String                  @id @default(uuid())
  modelCode            String                  @unique // e.g. 'CAD-2026-0084'
  name                 String
  description          String?
  fileFormat           CadFileFormat           @default(STEP)
  fileUrl              String
  fileSizeBytes        BigInt                  @default(0)
  version              String                  @default("v1.0")
  category             String                  // 'PART', 'SUB_ASSEMBLY', 'MAIN_ASSEMBLY', 'FIXTURE'
  materialSpec         String?                 // e.g. 'Aluminum 7075-T6', 'SS316L', 'Titanium Ti-6Al-4V'
  massKg               Decimal?                @db.Decimal(10, 4)
  volumeMm3            Decimal?                @db.Decimal(14, 2)
  status               CadStatus               @default(IN_REVIEW)
  author               String
  approvedBy           String?
  approvedAt           DateTime?

  drawings             TechnicalDrawing[]
  bomMasters           BillOfMaterialsMaster[]
  ecns                 EngineeringChangeNotice[]
  prototypeTests       PrototypeTestLog[]
  designSpecifications DesignSpecification[]

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([modelCode])
  @@index([status])
  @@index([category])
  @@index([fileFormat])
}

model TechnicalDrawing {
  id                      String                  @id @default(uuid())
  drawingNumber           String                  @unique // e.g. 'DWG-AERO-0192'
  title                   String
  cadModelId              String?
  cadModel                CadModel?               @relation(fields: [cadModelId], references: [id], onDelete: SetNull)
  sheetSize               DrawingSheetSize        @default(A1)
  revision                String                  @default("Rev 01")
  fileUrl                 String
  isApprovedForProduction Boolean                 @default(false)
  releasedToProductionAt  DateTime?
  releasedToQcAt          DateTime?
  criticalDimensions      Json?                   // [{ dimensionName, nominalMm, upperTolMm, lowerTolMm, isCpkMonitored }]
  geometricTolerances     String?                 // e.g. 'GD&T ASME Y14.5M, Position 0.02 True Position'
  surfaceFinishRa         Decimal?                @db.Decimal(6, 3) // e.g. 0.400 microns
  status                  BlueprintApprovalStatus @default(DRAFT)
  drawnBy                 String
  checkedBy               String?
  approvedBy              String?

  ecns                    EngineeringChangeNotice[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([drawingNumber])
  @@index([cadModelId])
  @@index([status])
  @@index([isApprovedForProduction])
}

model BillOfMaterialsMaster {
  id                 String                    @id @default(uuid())
  bomNumber          String                    @unique // e.g. 'BOM-2026-0042'
  title              String
  cadModelId         String?
  cadModel           CadModel?                 @relation(fields: [cadModelId], references: [id], onDelete: SetNull)
  revision           String                    @default("Rev A")
  status             BOMStatus                 @default(DRAFT)
  totalPartsCount    Int                       @default(0)
  estimatedTotalCost Decimal                   @default(0.0) @db.Decimal(14, 2)
  currency           String                    @default("USD")
  structureJson      Json                      // Multi-level hierarchy: [{ level, partNumber, partName, category, qty, uom, unitCost, material, supplier, drawingRef, children }]
  releasedBy         String?
  releasedAt         DateTime?

  ecns               EngineeringChangeNotice[]

  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([bomNumber])
  @@index([cadModelId])
  @@index([status])
}

model EngineeringChangeNotice {
  id                       String                  @id @default(uuid())
  ecnNumber                String                  @unique // e.g. 'ECN-2026-0081'
  title                    String
  cadModelId               String?
  cadModel                 CadModel?               @relation(fields: [cadModelId], references: [id], onDelete: SetNull)
  drawingId                String?
  drawing                  TechnicalDrawing?       @relation(fields: [drawingId], references: [id], onDelete: SetNull)
  bomMasterId              String?
  bomMaster                BillOfMaterialsMaster?  @relation(fields: [bomMasterId], references: [id], onDelete: SetNull)
  reasonForChange          ECNChangeReason         @default(DESIGN_OPTIMIZATION)
  priority                 ECNPriority             @default(MEDIUM)
  description              String
  changeScope              String                  // e.g. 'Affects Machine Bed Casting and Spindle Mounting Flange'
  status                   ECNStatus               @default(DRAFT)
  requestedBy              String
  reviewedBy               String?
  approvedBy               String?
  approvedAt               DateTime?
  implementationTargetDate DateTime?
  inventoryDisposition     String?                 // e.g. 'USE_EXISTING_STOCK_FIRST', 'SCRAP_IMMEDIATELY', 'REWORK_IN_SHOP'
  costImpactEstimate       Decimal?                @db.Decimal(12, 2)

  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([ecnNumber])
  @@index([cadModelId])
  @@index([status])
  @@index([priority])
  @@index([reasonForChange])
}

model PrototypeTestLog {
  id                     String              @id @default(uuid())
  testLogNumber          String              @unique // e.g. 'PTL-2026-0035'
  cadModelId             String
  cadModel               CadModel            @relation(fields: [cadModelId], references: [id], onDelete: Cascade)
  prototypeSerial        String              // e.g. 'PROTO-ENG-001'
  testType               PrototypeTestType   @default(STRESS_TEST)
  testParameters         Json                // { appliedLoadKn, maxStressMpa, testDurationHours, minTempC, maxTempC, cycleCount }
  observedOutcome        String
  result                 PrototypeTestResult @default(PASSED)
  maxDeformationMm       Decimal?            @db.Decimal(8, 4)
  yieldSafetyFactor      Decimal?            @db.Decimal(6, 2)
  engineerInCharge       String
  testedAt               DateTime            @default(now())
  nextIterationRequired  Boolean             @default(false)

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([testLogNumber])
  @@index([cadModelId])
  @@index([testType])
  @@index([result])
}

model DesignSpecification {
  id                       String            @id @default(uuid())
  specCode                 String            @unique // e.g. 'DSPEC-2026-0019'
  title                    String
  cadModelId               String?
  cadModel                 CadModel?         @relation(fields: [cadModelId], references: [id], onDelete: SetNull)
  standardCompliance       String            // e.g. 'ASME Y14.5, ISO 2768-mK, AS9100D, DIN 7168'
  operatingTempMinC        Decimal?          @db.Decimal(6, 2)
  operatingTempMaxC        Decimal?          @db.Decimal(6, 2)
  tensileStrengthMpa       Decimal?          @db.Decimal(10, 2)
  hardnessRating           String?           // e.g. '58-62 HRC', '120 HB'
  coatingRequirements      String?           // e.g. 'Hard Anodized Type III Class 2, Black Oxide'
  qualityBenchmarkingNotes String?
  publishedBy              String

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([specCode])
  @@index([cadModelId])
}

// =========================================================================
// FLEET & TRANSPORT MANAGEMENT MODULE
// =========================================================================

enum FleetVehicleType {
  HEAVY_TRUCK
  MEDIUM_TRUCK
  DELIVERY_VAN
  PICKUP_UTILITY
  PASSENGER_CAR
  ELECTRIC_FORKLIFT
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  ELECTRIC
  HYBRID
}

enum ServiceType {
  ROUTINE_PREVENTIVE
  BREAKDOWN_REPAIR
  TIRE_REPLACEMENT
  OIL_CHANGE
  ANNUAL_OVERHAUL
}

enum ServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  SCHEDULED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum ComplianceDocType {
  INSURANCE_POLICY
  PUC_CERTIFICATE
  FITNESS_CERTIFICATE
  ROAD_TAX
  NATIONAL_PERMIT
  REGISTRATION_RC
}

enum ComplianceDocStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING_RENEWAL
}

model FleetVehicle {
  id                    String                      @id @default(uuid())
  vehicleNumber         String                      @unique // e.g., 'KA-04-ME-4821'
  fleetCode             String                      @unique // e.g., 'FLT-TRK-0012'
  modelName             String                      // e.g., 'Tata Prima 4028.S'
  make                  String                      // e.g., 'Tata Motors'
  year                  Int                         @default(2024)
  vehicleType           FleetVehicleType            @default(HEAVY_TRUCK)
  status                VehicleStatus               @default(AVAILABLE)
  fuelType              FuelType                    @default(DIESEL)
  payloadCapacityKg     Decimal                     @db.Decimal(10, 2)
  totalOdometerKm       Decimal                     @default(0.0) @db.Decimal(12, 2)
  assignedDriver        String?
  fastagTagId           String?
  fuelCardNumber        String?
  gpsImei               String?
  purchaseDate          DateTime?
  insurancePolicyExpiry DateTime?
  pucExpiry             DateTime?
  fitnessExpiry         DateTime?
  roadTaxExpiry         DateTime?

  serviceLogs           VehicleServiceLog[]
  tripAssignments       VehicleAssignment[]
  fuelExpenses          FuelExpenseLog[]
  complianceDocuments   VehicleComplianceDocument[]

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([vehicleNumber])
  @@index([fleetCode])
  @@index([status])
  @@index([vehicleType])
  @@index([assignedDriver])
}

model VehicleServiceLog {
  id                 String         @id @default(uuid())
  serviceNumber      String         @unique // e.g., 'SRV-2026-0042'
  vehicleId          String
  vehicle            FleetVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType        ServiceType    @default(ROUTINE_PREVENTIVE)
  status             ServiceStatus  @default(COMPLETED)
  odometerAtService  Decimal        @db.Decimal(12, 2)
  serviceCenter      String
  partsReplaced      Json?          // [{ partName, partCode, qty, unitCost }]
  laborCost          Decimal        @default(0.0) @db.Decimal(10, 2)
  partsCost          Decimal        @default(0.0) @db.Decimal(10, 2)
  totalCost          Decimal        @db.Decimal(10, 2)
  serviceDate        DateTime       @default(now())
  nextServiceDueKm   Decimal?       @db.Decimal(12, 2)
  nextServiceDueDate DateTime?
  invoiceNumber      String?
  notes              String?
  recordedBy         String

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([serviceNumber])
  @@index([vehicleId])
  @@index([serviceType])
  @@index([status])
  @@index([serviceDate])
}

model VehicleAssignment {
  id                     String           @id @default(uuid())
  assignmentNumber       String           @unique // e.g., 'TRP-2026-0118'
  vehicleId              String
  vehicle                FleetVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverName             String
  driverContact          String
  routeTitle             String
  originLocation         String
  destinationLocation    String
  purpose                String           // 'RAW_MATERIAL_PICKUP', 'FINISHED_GOODS_DELIVERY', 'EMERGENCY_TOOLING_TRANSFER', 'CLIENT_DISPATCH'
  status                 AssignmentStatus @default(SCHEDULED)
  startOdometerKm        Decimal?         @db.Decimal(12, 2)
  endOdometerKm          Decimal?         @db.Decimal(12, 2)
  scheduledStart         DateTime
  actualStart            DateTime?
  scheduledEnd           DateTime?
  actualEnd              DateTime?
  cargoWeightKg          Decimal?         @db.Decimal(10, 2)
  linkedDispatchOrderRef String?
  notes                  String?
  dispatchedBy           String

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([assignmentNumber])
  @@index([vehicleId])
  @@index([status])
  @@index([driverName])
  @@index([scheduledStart])
}

model FuelExpenseLog {
  id                     String       @id @default(uuid())
  expenseCode            String       @unique // e.g., 'FUEL-2026-0092'
  vehicleId              String
  vehicle                FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fuelType               FuelType     @default(DIESEL)
  litersOrKwh            Decimal      @db.Decimal(10, 2)
  costPerUnit            Decimal      @db.Decimal(8, 2)
  totalFuelCost          Decimal      @db.Decimal(10, 2)
  tollCharges            Decimal      @default(0.0) @db.Decimal(8, 2)
  otherTravelExpenses    Decimal      @default(0.0) @db.Decimal(8, 2)
  totalExpense           Decimal      @db.Decimal(10, 2)
  odometerAtFueling      Decimal      @db.Decimal(12, 2)
  fuelStationName        String
  fuelCardTransactionRef String?
  paymentMethod          String       @default("FLEET_CARD")
  fueledAt               DateTime     @default(now())
  fuelEfficiencyKmPerLiter Decimal?   @db.Decimal(6, 2)
  recordedBy             String

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([expenseCode])
  @@index([vehicleId])
  @@index([fueledAt])
  @@index([paymentMethod])
}

model VehicleComplianceDocument {
  id                        String              @id @default(uuid())
  documentNumber            String              @unique // e.g., 'DOC-INS-2026-0012'
  vehicleId                 String
  vehicle                   FleetVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType                   ComplianceDocType   @default(INSURANCE_POLICY)
  policyOrCertificateNumber String
  issuingAuthority          String
  issueDate                 DateTime
  expiryDate                DateTime
  premiumOrFeeAmount        Decimal             @default(0.0) @db.Decimal(10, 2)
  status                    ComplianceDocStatus @default(ACTIVE)
  documentUrl               String?
  renewalAlertDays          Int                 @default(30)
  notes                     String?
  managedBy                 String

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([documentNumber])
  @@index([vehicleId])
  @@index([docType])
  @@index([status])
  @@index([expiryDate])
}

// =========================================================================
// PRICING & RATE ACCESS CONTROL (RBAC) MODULE
// =========================================================================

enum PriceType {
  RAW_MATERIAL_COST
  PRODUCT_SELLING_PRICE
}

enum PriceOverrideStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PriceFieldTarget {
  MATERIAL_COST
  BOM_COMPONENT_COST
  PURCHASE_ORDER_RATE
  QUOTATION_SELLING_RATE
  INVOICE_ITEM_PRICE
  DELIVERY_CHALLAN_RATE
}

model PricingAccessPolicy {
  id                         String            @id @default(uuid())
  roleName                   String            // e.g. 'PROCUREMENT_OFFICER', 'CRM_SALES_REP', 'DESIGN_ENGINEER'
  priceType                  PriceType
  targetField                PriceFieldTarget  @default(MATERIAL_COST)
  canView                    Boolean           @default(false)
  canEdit                    Boolean           @default(false)
  maxDiscountPct             Decimal?          @db.Decimal(5, 2) // For sales reps (e.g. up to 10%)
  minMarginPct               Decimal?          @db.Decimal(5, 2) // Floor margin
  requiresSupervisorOverride Boolean           @default(false)
  description                String?
  isActive                   Boolean           @default(true)

  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@unique([roleName, priceType, targetField])
  @@index([roleName])
  @@index([priceType])
  @@index([isActive])
}

model PriceOverrideRequest {
  id                  String              @id @default(uuid())
  requestNumber       String              @unique // e.g. 'OVR-2026-0042'
  targetEntity        String              // 'MaterialCatalog', 'Quotation', 'PurchaseOrderProcurement', 'ClientInvoice'
  entityId            String
  itemSku             String
  itemName            String?
  priceType           PriceType
  currentPrice        Decimal             @db.Decimal(14, 2)
  requestedPrice      Decimal             @db.Decimal(14, 2)
  deltaPercentage     Decimal             @db.Decimal(6, 2) // (requested - current) / current * 100
  justification       String
  requestedBy         String              // user email or id
  requesterRole       String
  status              PriceOverrideStatus @default(PENDING)
  reviewedBy          String?             // Super Admin / Owner
  reviewedAt          DateTime?
  reviewRemarks       String?
  validUntil          DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([requestNumber])
  @@index([targetEntity, entityId])
  @@index([status])
  @@index([requestedBy])
  @@index([reviewedBy])
}

model PriceAuditRecord {
  id                 String           @id @default(uuid())
  auditCode          String           @unique // e.g. 'PAUD-2026-0189'
  targetEntity       String           // 'MaterialCatalog', 'Quotation', 'BillOfMaterials', etc.
  entityId           String
  itemSku            String
  priceType          PriceType
  targetField        PriceFieldTarget
  oldPrice           Decimal          @db.Decimal(14, 2)
  newPrice           Decimal          @db.Decimal(14, 2)
  currency           String           @default("USD")
  modifiedBy         String           // User name or email
  userRole           String
  justification      String
  isOverrideApproved Boolean          @default(false)
  overrideRequestId  String?
  approvedBy         String?          // Owner / Super Admin
  ipAddress          String?
  timestamp          DateTime         @default(now())

  createdAt          DateTime         @default(now())

  @@index([auditCode])
  @@index([targetEntity, entityId])
  @@index([itemSku])
  @@index([modifiedBy])
  @@index([priceType])
  @@index([timestamp])
}

// ==========================================
// APEXMOBILE ERP: SMARTPHONE MANUFACTURING EXTENSIONS
// ==========================================

enum MobileComponentCategory {
  CHIPSET_SOC
  RAM_LPDDR
  STORAGE_UFS
  DISPLAY_PANEL
  BATTERY_PACK
  CAMERA_MODULE
  CHASSIS_FRAME
  BACK_COVER_GLASS
  VAPOR_CHAMBER
  FPC_CONNECTOR
  SPEAKER_HAPTIC
  RETAIL_PACKAGING
}

enum SmartphoneAssemblyStage {
  STAGE_1_SMT_PCB_PLACEMENT
  STAGE_2_CLEANROOM_DISPLAY_LAMINATION
  STAGE_3_CAMERA_CALIBRATION
  STAGE_4_OS_FLASH_RF_TEST
  STAGE_5_AGING_DROP_TEST
  STAGE_6_BOX_PACKING_IMEI_SCAN
}

enum MobileDeviceStatus {
  IN_SMT_PROGRESS
  IN_ASSEMBLY
  OS_FLASHED
  RF_CALIBRATED
  AGING_TEST_PASSED
  BOX_PACKED_SCANNED
  DISPATCHED
  RMA_QUARANTINE
}

enum MobileRfTestStatus {
  PENDING
  PASSED
  FAILED
  RETEST_REQUIRED
}

model MobileComponentInventory {
  id                   String                  @id @default(uuid())
  skuCode              String                  @unique // e.g. 'SOC-QCOM-8GEN3-01'
  name                 String
  category             MobileComponentCategory
  supplier             String                  // e.g. 'Qualcomm Enterprise Direct'
  specifications       String                  // e.g. '4nm TSMC, 3.3GHz Cortex-X4'
  unitCost             Decimal                 @db.Decimal(12, 2)
  stockQuantity        Int                     @default(0)
  allocatedQuantity    Int                     @default(0)
  safetyStockDays      Decimal                 @db.Decimal(5, 1) @default(5.0)
  binLocation          String                  // e.g. 'CLEANROOM-BIN-A01'
  isCriticalShortage   Boolean                 @default(false)

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([category])
  @@index([skuCode])
}

model MobileDeviceUnit {
  id                   String                  @id @default(uuid())
  serialNumber         String                  @unique // e.g. 'APX-2026-004812'
  imei1                String                  @unique // 15-digit TAC+SNR+CD
  imei2                String                  @unique // Dual SIM IMEI
  modelSku             String                  // e.g. 'APEX-PRO-5G-16GB-512GB'
  modelName            String                  @default("ApexPro 5G Flagship")
  colorVariant         String                  // e.g. 'Titanium Gray', 'Obsidian Black'
  ramRomConfig         String                  // e.g. '16GB+512GB'
  macAddressWifi       String?
  macAddressBluetooth  String?
  osBuildVersion       String                  @default("ApexOS-v2.5-Tiramisu")
  
  // 6 Assembly Line Milestones
  currentStage         SmartphoneAssemblyStage @default(STAGE_1_SMT_PCB_PLACEMENT)
  status               MobileDeviceStatus      @default(IN_SMT_PROGRESS)

  // Stage 4: RF & Calibration
  rfTestStatus         MobileRfTestStatus      @default(PENDING)
  rfBandsTested        String?                 // e.g. '5G NR: n1,n3,n28,n77,n78; LTE: B1,B3,B5,B40,B41'
  rfCalibratedAt       DateTime?

  // Stage 5: Aging & Drop Test
  agingDurationMinutes Int                     @default(0)
  agingPassedAt        DateTime?
  laserEngravedSerial  Boolean                 @default(false)

  // Stage 6: Box Packing & Dispatch
  boxBarcode           String?                 @unique // GS1-128 barcode on retail box
  packedAt             DateTime?
  dispatchedAt         DateTime?
  qcInspectorCode      String?                 // e.g. 'QC-INSP-04'

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([modelSku])
  @@index([status])
  @@index([currentStage])
}

model MobileProductionLine {
  id                   String                  @id @default(uuid())
  lineNumber           Int                     @unique // 1 to 6
  lineName             String                  // e.g. 'Line 1: SMT & PCB Placement'
  stage                SmartphoneAssemblyStage
  targetOutputUnits    Int                     @default(7600)
  actualProducedUnits  Int                     @default(0)
  firstPassYieldPct    Decimal                 @db.Decimal(5, 2) @default(99.4) // e.g. 99.40%
  defectPpm            Int                     @default(24) // Defects Per Million
  cycleTimeSeconds     Int                     @default(18) // Seconds per phone unit
  operatorCount        Int                     @default(32)
  isOperational        Boolean                 @default(true)
  cleanroomClass       String?                 // e.g. 'Class 100', 'Class 1000'

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([lineNumber])
  @@index([stage])
}

model MobileImeiBurnInLog {
  id                   String                  @id @default(uuid())
  burnInBatchCode      String                  @unique // e.g. 'BURN-2026-10-08-01'
  totalUnitsBurned     Int
  passedUnits          Int
  failedUnits          Int
  failedReason         String?
  technicianCode       String
  firmwareVersion      String
  burnInCompletedAt    DateTime                @default(now())

  createdAt            DateTime                @default(now())

  @@index([burnInBatchCode])
  @@index([burnInCompletedAt])
}

// ==========================================
// UNIVERSAL DEPARTMENTAL TASK DELEGATION MODULE
// ==========================================

enum TaskDelegationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskDelegationStatus {
  PENDING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  REJECTED
}

model DepartmentTaskDelegation {
  id                   String                 @id @default(uuid())
  taskCode             String                 @unique // e.g. 'DEL-2026-0042'
  department           String                 // e.g. 'SMT_PRODUCTION', 'WAREHOUSE_IMEI', 'QUALITY_RF', 'SUPPLY_CHAIN', 'COMMERCIAL_FINANCE', 'MOBILE_ENGINEERING'
  departmentLabel      String                 // e.g. 'SMT & PCB Production'
  
  // Manager (Delegator)
  managerId            String                 // User/Role ID
  managerName          String                 // e.g. 'Rajesh Sharma'
  managerRole          String                 // e.g. 'SMT Floor Manager'
  
  // Assistant Manager (Assignee)
  assistantId          String                 // User/Role ID
  assistantName        String                 // e.g. 'Vikram Joshi'
  assistantRole        String                 // e.g. 'Assistant SMT Manager'

  title                String
  description          String
  priority             TaskDelegationPriority @default(MEDIUM)
  status               TaskDelegationStatus   @default(PENDING)
  progressPercentage   Int                    @default(0) // 0 to 100
  
  dueDate              DateTime
  completedAt          DateTime?
  completionNotes      String?
  reviewRemarks        String?

  progressLogs         DepartmentTaskProgressLog[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([department])
  @@index([managerId])
  @@index([assistantId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model DepartmentTaskProgressLog {
  id                   String                   @id @default(uuid())
  taskDelegationId     String
  taskDelegation       DepartmentTaskDelegation @relation(fields: [taskDelegationId], references: [id], onDelete: Cascade)
  updatedBy            String                   // Name of assistant or manager
  userRole             String
  previousStatus       TaskDelegationStatus
  newStatus            TaskDelegationStatus
  previousProgress     Int
  newProgress          Int
  notes                String
  timestamp            DateTime                 @default(now())

  @@index([taskDelegationId])
  @@index([timestamp])
}


enum LeaveRecipientType {
  DEPARTMENT_MANAGER
  HR
}


model LeaveRequest {
  id                 String             @id @default(uuid())
  leaveCode          String             @unique // e.g. 'LV-2026-0042'
  employeeId         String             // e.g. 'plant_operator', 'maint_tech', 'production_lead'
  employeeName       String             // e.g. 'Sunil Joshi', 'Rajesh Sharma'
  employeeRole       String             // e.g. 'SMT Line Operator', 'SMT Floor Lead'
  department         String             // e.g. 'SMT_PRODUCTION', 'WAREHOUSE_IMEI', 'QUALITY_RF'
  departmentLabel    String             // e.g. 'SMT & PCB Production'
  recipientType      LeaveRecipientType @default(DEPARTMENT_MANAGER)
  
  targetApproverId   String?            // User ID of manager or HR officer
  targetApproverName String?            // Name of manager or HR officer
  
  leaveType          LeaveType          @default(CASUAL)
  startDate          DateTime
  endDate            DateTime
  durationDays       Int                @default(1)
  reason             String
  status             LeaveStatus        @default(PENDING)
  
  approverComments   String?
  reviewedAt         DateTime?
  reviewedBy         String?            // Name of approver
  reviewedRole       String?            // Role of approver
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([department])
  @@index([employeeId])
  @@index([recipientType])
  @@index([status])
  @@index([targetApproverId])
  @@index([startDate])
}

// ==================== PAYROLL & CREDENTIALING MODULE ====================

enum PayrollBatchStatus {
  PENDING_FINANCE_VERIFICATION
  VERIFIED
  RELEASED
  REJECTED
}


enum SalaryPaymentMode {
  DIRECT_BANK_TRANSFER
  NEFT
  RTGS
  CHEQUE
}

model UserCredential {
  id                 String             @id @default(uuid())
  employeeId         String             @unique // e.g. 'EMP-2026-0101'
  name               String             // e.g. 'Rameshwar Patil'
  email              String             // e.g. 'rameshwar@apexmobile.com'
  phone              String             // e.g. '+91 98765 43210'
  nationalId         String?            // Aadhaar / National ID
  address            String?
  role               String             // e.g. 'production', 'quality', 'finance'
  roleTitle          String             // e.g. 'Phone Assembly Technician'
  department         String             // e.g. 'Phone Assembly Lines'
  accessPermissions  String[]           @default(["STANDARD_WORKER_ACCESS"])
  username           String             @unique // e.g. 'rameshwar_patil'
  passwordHash       String
  isActive           Boolean            @default(true)
  employmentType     EmploymentType     @default(FULL_TIME)
  dateOfJoining      DateTime           @default(now())

  salaryStructure    SalaryStructure?
  payrollLineItems   PayrollLineItem[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([role])
  @@index([department])
  @@index([username])
  @@index([employeeId])
}

model SalaryStructure {
  id                   String            @id @default(uuid())
  userCredentialId     String            @unique
  userCredential       UserCredential    @relation(fields: [userCredentialId], references: [id], onDelete: Cascade)
  employeeId           String            @unique
  
  basicSalary          Float             // e.g. ₹20,000 / month
  hraAllowance         Float             @default(0) // House Rent Allowance (e.g. ₹8,000)
  conveyanceAllowance  Float             @default(0) // Conveyance Allowance (e.g. ₹1,600)
  specialAllowance     Float             @default(0) // Special Allowance (e.g. ₹2,400)
  grossSalary          Float             // Basic + HRA + Conveyance + Special
  
  esiDeduction         Float             // Statutory ESI deduction (0.75% of Gross)
  pfDeduction          Float             // Statutory PF deduction (12% of Basic)
  professionalTax      Float             @default(200) // Statutory PT (e.g. ₹200)
  totalDeductions      Float             // ESI + PF + PT
  netSalary            Float             // Gross - Total Deductions
  
  bankName             String            // e.g. 'HDFC Bank'
  accountNumber        String            // Bank Account Number
  ifscCode             String            // IFSC Code
  panNumber            String?           // Permanent Account Number
  uanNumber            String?           // Universal Account Number (PF)
  esiNumber            String?           // ESI IP Number
  paymentMode          SalaryPaymentMode @default(DIRECT_BANK_TRANSFER)

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([employeeId])
  @@index([userCredentialId])
}

model PayrollBatch {
  id                   String              @id @default(uuid())
  batchNumber          String              @unique // e.g. 'PAY-BATCH-2026-10'
  month                String              // e.g. 'October'
  year                 Int                 // e.g. 2026
  periodLabel          String              // e.g. 'October 2026 Shift Payroll'
  totalHeadcount       Int                 // e.g. 144 technicians & operators
  grossTotal           Float               // Total gross earnings
  totalEsi             Float               // Total ESI deducted
  totalPf              Float               // Total PF deducted
  totalNetPayout       Float               // Net bank payout total
  
  submittedBy          String              // e.g. 'Deepak Chawla (HR Lead)'
  submittedById        String?             // User ID of submitter
  status               PayrollBatchStatus  @default(PENDING_FINANCE_VERIFICATION)
  
  financeApproverId    String?             // User ID of Finance Lead
  financeApproverName  String?             // e.g. 'Amitabh Sen'
  financeNotes         String?             // Audit & verification comments
  bankDisbursementRef  String?             // e.g. 'HDFC-CORP-RTGS-994120'
  
  submittedAt          DateTime            @default(now())
  verifiedAt           DateTime?
  releasedAt           DateTime?

  lineItems            PayrollLineItem[]
  salaryCreditLogs     EmployeeSalaryCreditLog[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([year, month])
}

model PayrollLineItem {
  id                   String            @id @default(uuid())
  payrollBatchId       String
  payrollBatch         PayrollBatch      @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  
  userCredentialId     String?
  userCredential       UserCredential?   @relation(fields: [userCredentialId], references: [id])
  
  employeeId           String            // e.g. 'EMP-2026-0101'
  employeeName         String            // e.g. 'Rameshwar Patil'
  role                 String            // e.g. 'SMT Line Operator'
  department           String            // e.g. 'Phone Assembly Lines'
  
  payableDays          Int               @default(30)
  presentDays          Int               @default(28)
  leaveDays            Int               @default(2)
  overtimeHours        Float             @default(0)
  
  basicSalary          Float
  allowances           Float
  grossEarnings        Float
  esiDeduction         Float
  pfDeduction          Float
  totalDeductions      Float
  netPayout            Float
  
  bankName             String
  accountNumber        String
  ifscCode             String
  paymentStatus        String            @default("PENDING") // 'PENDING', 'VERIFIED', 'PROCESSED'

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([payrollBatchId])
  @@index([employeeId])
}

enum SalaryCreditStatus {
  CREDITED
  PENDING
  FAILED
  MISSED
}

model EmployeeSalaryCreditLog {
  id                String             @id @default(uuid())
  employeeId        String             // e.g. 'EMP-2026-0101'
  employeeName      String             // e.g. 'Rameshwar Patil'
  role              String             // e.g. 'SMT Line Operator'
  department        String             // e.g. 'Phone Assembly Lines'
  
  payrollBatchId    String
  payrollBatch      PayrollBatch       @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  
  netAmount         Float              // Net credited amount
  bankName          String?            // e.g. 'HDFC Bank'
  bankAccountNumber String             // e.g. '501004928109'
  ifscCode          String?            // e.g. 'HDFC0001092'
  
  creditStatus      SalaryCreditStatus @default(PENDING)
  transactionRef    String?            // e.g. 'HDFC-RTGS-990412-EMP-01'
  discrepancyReason String?            // e.g. 'Beneficiary IFSC Code Mismatch'
  
  creditedAt        DateTime?
  verifiedBy        String?            @default("Super Admin")
  isResolved        Boolean            @default(false)
  resolutionNotes   String?
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([payrollBatchId])
  @@index([employeeId])
  @@index([creditStatus])
  @@index([department])
}

// ==================== DEPARTMENTAL ATTENDANCE & PAYROLL MODULE ====================

enum DepartmentPayrollStatus {
  DRAFT
  SUBMITTED_TO_REVIEW
  APPROVED_BY_FINANCE
  REJECTED
}

model DepartmentPayrollSheet {
  id                   String                         @id @default(uuid())
  department           String                         // e.g. 'Line 1: Circuit Board Assembly Work'
  departmentCode       String?                        // e.g. 'SMT-001'
  managerId            String                         // e.g. 'mgr-prod-01'
  managerName          String                         // e.g. 'Suresh Raina (Line 1 Production Manager)'
  monthYear            String                         // e.g. 'October 2026'
  month                String                         @default("October")
  year                 Int                            @default(2026)
  workingDaysInMonth   Int                            @default(26)
  totalWorkers         Int                            @default(0)
  totalGrossAmount     Float                          @default(0)
  totalEsiAmount       Float                          @default(0)
  totalPfAmount        Float                          @default(0)
  totalAmount          Float                          @default(0) // Total net payable
  status               DepartmentPayrollStatus        @default(DRAFT)
  managerNotes         String?
  submittedAt          DateTime?

  // Review & Audit tracking for HR, Finance, Super Admin
  hrReviewerId         String?
  hrReviewerName       String?
  hrNotes              String?
  hrStatus             String?                        @default("PENDING") // PENDING, APPROVED, FLAGGED
  hrReviewedAt         DateTime?

  financeReviewerId    String?
  financeReviewerName  String?
  financeNotes         String?
  financeStatus        String?                        @default("PENDING") // PENDING, APPROVED, FLAGGED
  financeReviewedAt    DateTime?

  superAdminReviewerId String?
  superAdminReviewerName String?
  superAdminNotes      String?
  superAdminStatus     String?                        @default("PENDING") // PENDING, APPROVED, FLAGGED
  superAdminReviewedAt DateTime?

  clearanceReference   String?                        // e.g. 'DEPT-CLR-SMT-2026-10-994'

  records              WorkerAttendanceSalaryRecord[]

  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@index([department])
  @@index([managerId])
  @@index([status])
  @@index([monthYear])
}

model WorkerAttendanceSalaryRecord {
  id                  String                  @id @default(uuid())
  sheetId             String
  sheet               DepartmentPayrollSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  
  workerId            String                  // e.g. 'EMP-2026-0101'
  workerName          String                  // e.g. 'Rameshwar Patil'
  role                String                  // e.g. 'Circuit Board Pick-and-Place Operator'
  department          String                  @default("Phone Assembly Lines")
  
  totalWorkingDays    Int                     @default(26)
  daysPresent         Int                     @default(26)
  daysAbsent          Int                     @default(0)
  overtimeHours       Float                   @default(0)
  
  baseSalaryRate      Float                   // Monthly wage base
  basicPay            Float                   // Prorated basic pay based on days present
  overtimePay         Float                   @default(0)
  allowances          Float                   @default(0)
  grossPay            Float
  
  esiDeduction        Float                   // Statutory 0.75% if gross <= 21,000, else 0
  pfDeduction         Float                   // Statutory 12% of basicPay
  professionalTax     Float                   @default(200)
  totalDeductions     Float
  netPayable          Float
  
  remarks             String?                 // e.g. 'Full attendance + 14 hrs OT in night shift'
  isTurnstileVerified Boolean                 @default(true)

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([sheetId])
  @@index([workerId])
}














