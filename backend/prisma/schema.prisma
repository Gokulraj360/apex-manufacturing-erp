model CompetitorMarketTrend {
  id                   String           @id @default(uuid())
  trendCode            String           @unique // e.g. 'TRD-2026-0089'
  competitorName       String
  marketSegment        String
  observedPricePerUnit Decimal?         @db.Decimal(12, 2)
  ourComparablePrice   Decimal?         @db.Decimal(12, 2)
  priceVariancePct     Decimal?         @db.Decimal(5, 2)
  demandIndex          Int              @default(75) // 1 to 100
  impactLevel          TrendImpactLevel @default(MEDIUM)
  marketObservations   String
  recommendedStrategy  String?
  recordedBy           String
  observedAt           DateTime         @default(now())

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([trendCode])
  @@index([competitorName])
  @@index([marketSegment])
  @@index([impactLevel])
  @@index([observedAt])
}

model AdvertisingBudget {
  id                   String               @id @default(uuid())
  budgetId             String               @unique // e.g. 'ADV-BGT-2026-015'
  campaignId           String?
  campaign             MarketingCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  eventName            String
  category             String               // 'EXPO_STALL', 'DIGITAL_MEDIA_BUY', 'BROCHURE_PRINTING', 'SPONSORSHIP'
  proposedAmount       Decimal              @db.Decimal(12, 2)
  approvedAmount       Decimal?             @db.Decimal(12, 2)
  vendorOrPlatform     String
  approvalStatus       BudgetApprovalStatus @default(DRAFT)
  submittedToFinanceAt DateTime?
  approvedByFinance    String?
  approvedAt           DateTime?
  journalEntryRef      String?              // Accounts finance reconciliation link
  requestedBy          String
  justification        String?

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([budgetId])
  @@index([campaignId])
  @@index([approvalStatus])
  @@index([category])
}

model CustomerFeedbackSurvey {
  id                   String               @id @default(uuid())
  surveyCode           String               @unique // e.g. 'SURV-2026-0032'
  title                String
  targetAudience       SurveyTargetAudience @default(OEM_CLIENTS)
  channel              String               // 'EMAIL_CAMPAIGN', 'POST_DELIVERY_PORTAL', 'PUBLIC_INDUSTRY_LINK'
  status               SurveyStatus         @default(PUBLISHED)
  totalResponses       Int                  @default(0)
  averageCSATScore     Decimal              @default(4.5) @db.Decimal(3, 2)
  brandPerceptionScore Decimal              @default(85.0) @db.Decimal(5, 2)
  keyStrengths         String[]             @default([])
  improvementAreas     String[]             @default([])
  questionsJson        Json                 // Structured questions
  feedbackResponses    Json?                // Response stream data
  publishedBy          String

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([surveyCode])
  @@index([targetAudience])
  @@index([status])
}

