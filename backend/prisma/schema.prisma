model MarketingCampaign {
  id                     String             @id @default(uuid())
  campaignCode           String             @unique // e.g. 'MC-2026-0042'
  name                   String
  description            String?
  type                   CampaignType       @default(DIGITAL_ADS)
  status                 CampaignStatus     @default(PLANNING)
  startDate              DateTime
  endDate                DateTime?
  targetAudience         String
  allocatedBudget        Decimal            @db.Decimal(12, 2)
  actualSpent            Decimal            @default(0.0) @db.Decimal(12, 2)
  impressions            Int                @default(0)
  clicks                 Int                @default(0)
  leadsGenerated         Int                @default(0)
  pipelineValueGenerated Decimal            @default(0.0) @db.Decimal(14, 2)
  roiPercentage          Decimal?           @db.Decimal(6, 2)
  channel                String             // e.g. 'LinkedIn B2B Sponsored, IMTEX 2026 Expo'
  leadManager            String

  leads                  Lead[]
  digitalAssets          DigitalAsset[]
  budgets                AdvertisingBudget[]

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([campaignCode])
  @@index([type])
  @@index([status])
  @@index([startDate])
