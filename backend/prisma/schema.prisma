model DepartmentWorkstationAssignment {
  id                    String             @id @default(uuid())
  assignmentCode        String             @unique // e.g. 'DWA-2026-0012'
  employeeId            String
  employee              Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  stationIdentifier     String             // e.g. 'WS-CNC-04', 'LINE-ASSEMBLY-02', 'WELD-CELL-01'
  machineAssetId        String?
  machineAsset          MachineAsset?      @relation(fields: [machineAssetId], references: [id], onDelete: SetNull)
  shiftCode             String             @default("SHIFT_A") // SHIFT_A, SHIFT_B, SHIFT_C, GENERAL
  assignmentDate        DateTime
  roleOnStation         WorkstationRole    @default(PRIMARY_OPERATOR)
  status                DeploymentStatus   @default(ACTIVE)
  certificationVerified Boolean            @default(true)
  supervisorRemarks     String?

  targetOutputs         DepartmentTargetOutput[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([assignmentCode])
  @@index([employeeId])
  @@index([departmentId])
  @@index([stationIdentifier])
  @@index([machineAssetId])
  @@index([assignmentDate])
  @@index([status])
}

model DepartmentAttendance {
  id                    String               @id @default(uuid())
  attendanceCode        String               @unique // e.g. 'DATT-2026-10-07-001'
  employeeId            String
  employee              Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  attendanceDate        DateTime
  checkInTime           DateTime?
  checkOutTime          DateTime?
  plannedHours          Decimal              @default(8.0) @db.Decimal(5, 2)
  actualHours           Decimal              @default(0.0) @db.Decimal(5, 2)
  overtimeHours         Decimal              @default(0.0) @db.Decimal(5, 2)
  overtimeApproved      Boolean              @default(false)
  overtimeReason        String?
  status                DeptAttendanceStatus @default(PRESENT)
  leaveType             DeptLeaveType?       @default(NONE)
  leaveApprovedBy       String?
  biometricVerification Boolean              @default(true)
  supervisorNotes       String?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([attendanceCode])
  @@index([employeeId])
  @@index([departmentId])
  @@index([attendanceDate])
  @@index([status])
}

model DepartmentTargetOutput {
  id                      String                           @id @default(uuid())
  targetCode              String                           @unique // e.g. 'DTO-2026-0819'
  departmentId            String
  department              Department                       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId              String
  employee                Employee                         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workstationAssignmentId String?
  workstationAssignment   DepartmentWorkstationAssignment? @relation(fields: [workstationAssignmentId], references: [id], onDelete: SetNull)
  workstationOrLine       String                           // e.g. 'WS-CNC-04', 'LINE-ASSEMBLY-02'
  productSku              String
  productName             String
  shiftDate               DateTime
  shiftCode               String                           @default("SHIFT_A")
  targetQuantity          Int
  actualQuantity          Int
  rejectedQuantity        Int                              @default(0)
  reworkQuantity          Int                              @default(0)
  efficiencyRatePct       Decimal                          @db.Decimal(5, 2)
  downtimeMinutes         Int                              @default(0)
  downtimeReason          String?
  supervisorSignoff       String?

  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@index([targetCode])
  @@index([departmentId])
  @@index([employeeId])
  @@index([workstationAssignmentId])
  @@index([shiftDate])
  @@index([productSku])
}

model MachineCertificationCheck {
  id                  String        @id @default(uuid())
  checkCode           String        @unique // e.g. 'MCC-2026-0511'
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  machineAssetId      String?
  machineAsset        MachineAsset? @relation(fields: [machineAssetId], references: [id], onDelete: SetNull)
  machineModel        String        // e.g. 'DMG MORI 5-Axis CNC Mill DMU 50'
  certificationType   String        // e.g. '5-Axis CNC High-Precision Machining'
  certifyingBody      String        // e.g. 'DMG MORI Academy / ISO 45001 Safety Cell'
  certificationNumber String
  issueDate           DateTime
  expiryDate          DateTime
  isValid             Boolean       @default(true)
  safetyScore         Decimal?      @db.Decimal(5, 2)
  lastIncidentDate    DateTime?
  verifiedBy          String
  verifiedAt          DateTime      @default(now())

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([checkCode])
  @@index([employeeId])
  @@index([machineAssetId])
  @@index([isValid])
  @@index([expiryDate])
}

model DepartmentLaborMetric {
  id                       String                   @id @default(uuid())
  metricCode               String                   @unique // e.g. 'DLM-2026-10-07-PUNE'
  departmentId             String
  department               Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  metricDate               DateTime
  shiftCode                String                   @default("SHIFT_A")
  totalScheduledWorkers    Int
  totalPresentWorkers      Int
  attendanceRatePct        Decimal                  @db.Decimal(5, 2)
  totalTargetOutput        Int
  totalActualOutput        Int
  productionEfficiencyPct  Decimal                  @db.Decimal(5, 2)
  totalOvertimeHours       Decimal                  @default(0.0) @db.Decimal(8, 2)
  laborUtilizationRatePct  Decimal                  @db.Decimal(5, 2)
  payrollStatus            DeptPayrollHandoffStatus @default(PENDING_AUDIT)
  auditedBy                String?
  auditedAt                DateTime?

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([departmentId, metricDate, shiftCode])
  @@index([metricCode])
  @@index([departmentId])
  @@index([metricDate])
  @@index([payrollStatus])
}

