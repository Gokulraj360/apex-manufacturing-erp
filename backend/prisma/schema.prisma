  DISPATCHED
  IN_TRANSIT
  DELIVERED_TO_VENDOR
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum SubcontractQualityStatus {
  PENDING_INSPECTION
  QC_PASSED
  QC_REJECTED
  CONDITIONALLY_ACCEPTED
