  ASSISTANT_OPERATOR
  LINE_LEAD
  QUALITY_CHECKER
  MAINTENANCE_TECH
  TRAINEE
}

enum DeploymentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
  STANDBY
  CANCELLED
}

enum DeptAttendanceStatus {
  PRESENT
  LATE_ARRIVAL
  HALF_DAY
  ON_LEAVE
  ABSENT
  ON_DUTY
}

enum DeptLeaveType {
  CASUAL
  SICK
  EARNED
  COMPENSATORY_OFF
  UNPAID_LEAVE
  NONE
}

enum DeptPayrollHandoffStatus {
  PENDING_AUDIT
  VERIFIED
  EXPORTED_TO_PAYROLL
  RECONCILED
