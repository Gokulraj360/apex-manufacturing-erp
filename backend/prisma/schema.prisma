  budget           Decimal?     @db.Decimal(18, 2)

  employees              Employee[]
  jobOpenings            JobOpening[]
  workstationAssignments DepartmentWorkstationAssignment[]
  departmentAttendances   DepartmentAttendance[]
  targetOutputs           DepartmentTargetOutput[]
  laborMetrics            DepartmentLaborMetric[]

  createdAt              DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([code])
}

model Designation {
  id          String       @id @default(uuid())
  title       String       @unique
  code        String       @unique
  level       Int          @default(1)
  minSalary   Decimal?     @db.Decimal(18, 2)
  maxSalary   Decimal?     @db.Decimal(18, 2)

  employees   Employee[]
  jobOpenings JobOpening[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([code])
}

model Employee {
  id                    String                 @id @default(uuid())
  employeeCode          String                 @unique
  firstName             String
  lastName              String
  email                 String                 @unique
  phone                 String
  departmentId          String
  department            Department             @relation(fields: [departmentId], references: [id])
  designationId         String
  designation           Designation            @relation(fields: [designationId], references: [id])
  employmentStatus      EmploymentStatus       @default(ACTIVE)
  employmentType        EmploymentType         @default(FULL_TIME)
  dateOfJoining         DateTime
  dateOfLeaving         DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  panOrTaxId            String?
  aadhaarOrNationalId   String?
  bankAccountNumber     String?
  bankIfscOrRouting     String?
  baseSalary            Decimal                @db.Decimal(18, 2)
  hourlyOvertimeRate    Decimal                @default(0.0) @db.Decimal(18, 2)
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id])

  attendanceLogs        AttendanceLog[]
  shiftRosters          ShiftRoster[]
  leaveRequests         EmployeeLeaveRequest[]
  overtimeRecords       OvertimeRecord[]
  onboardingDocuments   OnboardingDocument[]
  safetyTrainingRecords SafetyTrainingRecord[]
  workstationAssignments DepartmentWorkstationAssignment[]
  departmentAttendances   DepartmentAttendance[]
  departmentOutputs       DepartmentTargetOutput[]
  machineCertChecks       MachineCertificationCheck[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([employeeCode])
  @@index([departmentId])
  @@index([designationId])
  @@index([employmentStatus])
}

model AttendanceLog {
  id                   String           @id @default(uuid())
  employeeId           String
  employee             Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                 DateTime
  clockIn              DateTime?
  clockOut             DateTime?
  totalHours           Decimal?         @db.Decimal(5, 2)
  status               AttendanceStatus @default(PRESENT)
  biometricDeviceId    String?
  locationCoordinates  String?
  isRegularized        Boolean          @default(false)
  regularizationNotes  String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model ShiftRoster {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftName          String    // e.g. 'Morning Shift (A)'
  shiftCode          String    // e.g. 'S-MORN'
  startTime          String    // e.g. '06:00'
  endTime            String    // e.g. '14:30'
  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  weekOffDay         String    @default("SUNDAY")
  isRotational       Boolean   @default(true)
  notes              String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employeeId])
  @@index([shiftCode])
}

model EmployeeLeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType   @default(CASUAL)
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal     @db.Decimal(4, 1)
  reason          String
  status          LeaveStatus @default(PENDING)
  appliedAt       DateTime    @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewerRemarks String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
}

model OvertimeRecord {
  id                   String   @id @default(uuid())
  employeeId           String
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                 DateTime
  overtimeHours        Decimal  @db.Decimal(5, 2)
  hourlyRate           Decimal  @db.Decimal(18, 2)
  calculatedAmount     Decimal  @db.Decimal(18, 2)
  reason               String
  isApproved           Boolean  @default(false)
  approvedBySupervisor String?
  dispatchedToPayroll  Boolean  @default(false)
  payrollMonth         Int?
  payrollYear          Int?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([isApproved])
  @@index([dispatchedToPayroll])
}

model JobOpening {
  id                      String              @id @default(uuid())
  requisitionNumber       String              @unique // e.g. 'JOB-2026-012'
  title                   String
  departmentId            String
  department              Department          @relation(fields: [departmentId], references: [id])
  designationId           String
  designation             Designation         @relation(fields: [designationId], references: [id])
  openingsCount           Int                 @default(1)
  hiredCount              Int                 @default(0)
  jobDescription          String
  requiredExperienceYears Int                 @default(2)
  status                  JobOpeningStatus    @default(OPEN)
  postedDate              DateTime            @default(now())
  targetClosingDate       DateTime?

  candidates              CandidateInterview[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([requisitionNumber])
  @@index([departmentId])
  @@index([status])
}

model CandidateInterview {
  id                   String                  @id @default(uuid())
  jobOpeningId         String
  jobOpening           JobOpening              @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  candidateName        String
  candidateEmail       String
  candidatePhone       String
  currentEmployer      String?
  experienceYears      Decimal?                @db.Decimal(4, 1)
  resumeUrl            String?
  currentStage         CandidateInterviewStage @default(APPLIED)
  interviewScore       Int?
  interviewerNotes     String?
  interviewScheduledAt DateTime?
  offeredCtc           Decimal?                @db.Decimal(18, 2)
  offerAccepted        Boolean?

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([jobOpeningId])
  @@index([currentStage])
}

model OnboardingDocument {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentName       String
  documentType       String
  documentUrl        String
  verificationStatus String   @default("VERIFIED")
  verifiedBy         String?
  verifiedAt         DateTime?
  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([employeeId])
  @@index([verificationStatus])
}

model SafetyTrainingRecord {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingProgramName String
  trainerAgency       String
  trainingDate        DateTime
  validityExpiryDate  DateTime?
  certificateNumber   String?
  passedAssessment    Boolean   @default(true)
  assessmentScore     Decimal?  @db.Decimal(5, 2)
  notes               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([employeeId])
  @@index([trainingDate])
}

model LaborComplianceDocument {
  id                    String                 @id @default(uuid())
  complianceTitle       String
  documentCategory      ComplianceDocumentType @default(FACTORIES_ACT)
  statutoryAuthority    String
  filingPeriod          String
  filingDate            DateTime
  nextRenewalDate       DateTime?
  acknowledgementNumber String?
  documentUrl           String?
  complianceStatus      String                 @default("COMPLIANT")
  auditedBy             String?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([documentCategory])
  @@index([filingPeriod])
  @@index([complianceStatus])
}

// ==================== SYSTEM ADMIN & TECHNICAL INFRASTRUCTURE MODULE ====================

enum HardwareDeviceType {
