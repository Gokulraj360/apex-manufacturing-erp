model DigitalAsset {
  id                   String            @id @default(uuid())
  assetCode            String            @unique // e.g. 'MKT-AST-0104'
  title                String
  description          String?
  type                 DigitalAssetType  @default(PRODUCT_BROCHURE)
  fileUrl              String
  fileSizeBytes        BigInt            @default(0)
  mimeType             String            @default("application/pdf")
  version              String            @default("v1.0")
  isPublic             Boolean           @default(true)
  partnerAccessAllowed Boolean           @default(true)
  downloadCount        Int               @default(0)
  campaignId           String?
  campaign             MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  tags                 String[]          @default([])
  uploadedBy           String

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([assetCode])
  @@index([type])
  @@index([campaignId])
  @@index([isPublic])
