model SubcontractorVendor {
  id                    String                         @id @default(uuid())
  vendorCode            String                         @unique // e.g. 'VEN-SC-001'
  companyName           String
  contactPerson         String
  email                 String
  phone                 String
  address               String
  city                  String
  gstinTaxId            String?
  specializedProcesses  String[]
  qualityRating         Decimal                        @default(95.0) @db.Decimal(5, 2)
  avgTurnaroundDays     Decimal                        @default(3.5) @db.Decimal(5, 2)
  isActive              Boolean                        @default(true)

  jobWorkOrders         JobWorkOrder[]
  challans              SubcontractorChallan[]
  receipts              SubcontractorReceipt[]
  bills                 SubcontractorBill[]
  performanceLogs       SubcontractorPerformanceLog[]

  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([vendorCode])
  @@index([companyName])
  @@index([isActive])
}

model JobWorkOrder {
  id                     String                 @id @default(uuid())
  orderNumber            String                 @unique // e.g. 'JWO-2026-0042'
  vendorId               String
  vendor                 SubcontractorVendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  processType            SubcontractProcessType @default(ELECTROPLATING)
  processDescription     String
  targetProductPart      String
  inputItemSku           String
  outputItemSku          String
  targetQuantity         Int
  receivedQuantity       Int                    @default(0)
  rejectedQuantity       Int                    @default(0)
  scrapAllowancePercent  Decimal                @default(2.0) @db.Decimal(5, 2)
  unitProcessingRate     Decimal                @db.Decimal(12, 2)
  totalOrderValue        Decimal                @db.Decimal(14, 2)
  status                 JobWorkStatus          @default(ISSUED)
  issuedDate             DateTime               @default(now())
  expectedDeliveryDate   DateTime
  completedDate          DateTime?
  notes                  String?

  challans               SubcontractorChallan[]
  receipts               SubcontractorReceipt[]
  bills                  SubcontractorBill[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([orderNumber])
  @@index([vendorId])
  @@index([status])
  @@index([processType])
}

model SubcontractorChallan {
  id                  String                   @id @default(uuid())
  challanNumber       String                   @unique // e.g. 'DC-SC-2026-0091'
  challanType         SubcontractChallanType   @default(RETURNABLE)
  jobWorkOrderId      String
  jobWorkOrder        JobWorkOrder             @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  vendorId            String
  vendor              SubcontractorVendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  dispatchDate        DateTime                 @default(now())
  expectedReturnDate  DateTime?
  vehicleNumber       String?
  transporterName     String?
  driverContact       String?
  eWayBillNumber      String?
  status              SubcontractChallanStatus @default(DISPATCHED)
  items               Json                     // array of item objects
  totalQuantitySent   Int
  totalValuation      Decimal                  @db.Decimal(14, 2)
  notes               String?

  receipts            SubcontractorReceipt[]

  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([challanNumber])
  @@index([jobWorkOrderId])
  @@index([vendorId])
  @@index([status])
  @@index([challanType])
}

model SubcontractorReceipt {
  id                       String                   @id @default(uuid())
  receiptNumber            String                   @unique // e.g. 'SR-2026-0081'
  jobWorkOrderId           String
  jobWorkOrder             JobWorkOrder             @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  challanId                String
  challan                  SubcontractorChallan     @relation(fields: [challanId], references: [id], onDelete: Cascade)
  vendorId                 String
  vendor                   SubcontractorVendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  receiptDate              DateTime                 @default(now())
  receivedQuantity         Int
  acceptedQuantity         Int
  rejectedQuantity         Int                      @default(0)
  scrapReported            Int                      @default(0)
  qualityStatus            SubcontractQualityStatus @default(PENDING_INSPECTION)
  inspectorName            String?
  inspectionRemarks        String?
  reconciliationVariance   Int                      @default(0) // Input Sent - (Accepted + Rejected + Scrap)
  isReconciliationBalanced Boolean                  @default(false)
  billId                   String?
  bill                     SubcontractorBill?       @relation(fields: [billId], references: [id], onDelete: SetNull)

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([receiptNumber])
  @@index([jobWorkOrderId])
  @@index([challanId])
  @@index([vendorId])
  @@index([qualityStatus])
}

model SubcontractorBill {
  id                String                 @id @default(uuid())
  billNumber        String                 @unique // e.g. 'SCB-2026-0038'
  vendorInvoiceRef  String
  vendorId          String
  vendor            SubcontractorVendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  jobWorkOrderId    String
  jobWorkOrder      JobWorkOrder           @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  billedQuantity    Int
  processingRate    Decimal                @db.Decimal(12, 2)
  subtotalAmount    Decimal                @db.Decimal(14, 2)
  taxAmount         Decimal                @default(0.0) @db.Decimal(12, 2)
  totalAmount       Decimal                @db.Decimal(14, 2)
  status            SubcontractBillStatus  @default(PENDING_APPROVAL)
  approvedBy        String?
  approvedAt        DateTime?
  syncedToFinance   Boolean                @default(false)
  paymentDueDate    DateTime?

  receipts          SubcontractorReceipt[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([billNumber])
  @@index([vendorId])
  @@index([jobWorkOrderId])
  @@index([status])
  @@index([syncedToFinance])
}

model SubcontractorPerformanceLog {
  id                   String              @id @default(uuid())
  vendorId             String
  vendor               SubcontractorVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  evaluationPeriod     String              // e.g. '2026-Q3'
  totalOrdersEvaluated Int
  onTimeDeliveryRate   Decimal             @db.Decimal(5, 2) // %
  avgTurnaroundDays    Decimal             @db.Decimal(5, 2)
  rejectionRate        Decimal             @db.Decimal(5, 2) // %
  scrapRate            Decimal             @db.Decimal(5, 2) // %
  compositeScore       Decimal             @db.Decimal(5, 2) // out of 100
  vendorTier           String              @default("TIER_1")
  evaluatedBy          String
  evaluationDate       DateTime            @default(now())

  @@index([vendorId])
  @@index([evaluationPeriod])
}

// ==================== SUPPLY CHAIN MANAGEMENT MODULE ====================

enum MRPPlanStatus {
  DRAFT
  COMPUTED
  RELEASED
  ARCHIVED
}

enum RequisitionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED_TO_PO
}

enum SupplyPOStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  FULFILLED
  CANCELLED
}

enum VendorTierRating {
  TIER_1_STRATEGIC
  TIER_2_PREFERRED
  TIER_3_TRANSACTIONAL
  PROBATION
}

enum TransportMode {
  AIR
  OCEAN
  ROAD
  RAIL
}

enum ShipmentMilestone {
  BOOKED
  DEPARTED_ORIGIN
  IN_CUSTOMS
  PORT_CLEARANCE
  IN_FINAL_TRANSIT
  DELIVERED_AT_DOCK
  EXCEPTION_DELAY
}

enum RiskCategory {
  SUPPLIER_SOLVENCY
  GEOPOLITICAL
  LOGISTICS_DISRUPTION
  PRICE_VOLATILITY
  SINGLE_SOURCE_DEPENDENCY
  LEAD_TIME_SPIKE
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  MITIGATION_IN_PROGRESS
  RESOLVED
  ACCEPTED
}

model MaterialRequirementPlan {
  id                      String        @id @default(uuid())
  planNumber              String        @unique // e.g. 'MRP-2026-0041'
  planName                String
  planningHorizonWeeks    Int           @default(12)
  status                  MRPPlanStatus @default(DRAFT)
  generatedBy             String
  forecastStartDate       DateTime
  forecastEndDate         DateTime
  grossDemandJson         Json          // [{ itemSku, itemName, requiredQty, sourceWorkOrderId, requiredDate }]
  scheduledReceiptsJson   Json          // [{ itemSku, incomingQty, poNumber, expectedDate }]
  netRequirementsJson     Json          // [{ itemSku, itemName, netShortageQty, safetyStockThreshold, currentOnhand, leadTimeDays }]
  plannedOrderReleasesJson Json         // [{ itemSku, orderQty, releaseDate, needDate, suggestedVendorId }]
  safetyStockAlertsCount  Int           @default(0)
  totalItemsPlanned       Int           @default(0)
  notes                   String?

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([planNumber])
  @@index([status])
}

model PurchaseRequisition {
  id                   String              @id @default(uuid())
  requisitionNumber    String              @unique // e.g. 'PR-2026-0082'
  requestedBy          String
  department           String
  requiredByDate       DateTime
  priority             RequisitionPriority @default(MEDIUM)
  status               PurchaseRequisitionStatus   @default(DRAFT)
  totalEstimatedCost   Decimal             @db.Decimal(14, 2)
  justification        String
  items                Json                // [{ itemSku, itemName, quantity, uom, estimatedUnitPrice, preferredVendorId }]
  approvedBy           String?
  approvedAt           DateTime?
  rejectionReason      String?

  purchaseOrders       PurchaseOrderSupply[]
  rfqs                 RequestForQuotation[]
  procurementOrders    PurchaseOrderProcurement[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([requisitionNumber])
  @@index([status])
  @@index([priority])
}

model PurchaseOrderSupply {
  id                   String                @id @default(uuid())
  poNumber             String                @unique // e.g. 'POS-2026-0112'
  vendorId             String
  vendor               VendorDirectory       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  requisitionId        String?
  requisition          PurchaseRequisition?  @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  orderDate            DateTime              @default(now())
  expectedDeliveryDate DateTime
  actualDeliveryDate   DateTime?
  paymentTerms         String                @default("NET_30")
  incoterms            String                @default("FOB")
  status               SupplyPOStatus        @default(DRAFT)
  currency             String                @default("USD")
  subtotal             Decimal               @db.Decimal(14, 2)
  taxAmount            Decimal               @default(0.0) @db.Decimal(12, 2)
  totalAmount          Decimal               @db.Decimal(14, 2)
  shippingAddress      String
  items                Json                  // [{ itemSku, itemName, orderedQty, receivedQty, unitPrice, lineTotal }]
  issuedBy             String
  acknowledgedBy       String?
  notes                String?

  shipments            InboundShipmentCoordination[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([poNumber])
  @@index([vendorId])
  @@index([status])
  @@index([expectedDeliveryDate])
}

model VendorDirectory {
  id                   String                @id @default(uuid())
  vendorCode           String                @unique // e.g. 'VND-SUP-001'
  companyName          String
  contactPerson        String
  email                String
  phone                String
  address              String
  city                 String
  country              String                @default("India")
  taxIdGstin           String?
  tierRating           VendorTierRating      @default(TIER_2_PREFERRED)
  categories           String[]              // ['RAW_METALS', 'FASTENERS', 'CHEMICALS']
  leadTimeDaysAvg      Int                   @default(7)
  onTimeDeliveryRate   Decimal               @default(95.0) @db.Decimal(5, 2) // %
  qualityScore         Decimal               @default(96.0) @db.Decimal(5, 2) // %
  costCompetitiveness  Decimal               @default(90.0) @db.Decimal(5, 2) // %
  overallScore         Decimal               @default(93.6) @db.Decimal(5, 2) // Composite
  paymentTerms         String                @default("NET_30")
  isActive             Boolean               @default(true)

  purchaseOrders       PurchaseOrderSupply[]
  shipments            InboundShipmentCoordination[]
  riskLogs             SupplyRiskLog[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([vendorCode])
  @@index([companyName])
  @@index([tierRating])
  @@index([isActive])
}

model InboundShipmentCoordination {
  id                      String             @id @default(uuid())
  shipmentTrackingNumber  String             @unique // e.g. 'INB-SHP-2026-041'
  poId                    String?
  po                      PurchaseOrderSupply? @relation(fields: [poId], references: [id], onDelete: SetNull)
  vendorId                String
  vendor                  VendorDirectory    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  carrierName             String
  freightForwarder        String?
  transportMode           TransportMode      @default(ROAD)
  originPortCity          String
  destinationPlantCity    String
  dispatchDate            DateTime
  estimatedArrivalDate    DateTime
  actualArrivalDate       DateTime?
  currentMilestone        ShipmentMilestone  @default(BOOKED)
  trackingMilestonesJson  Json               // [{ milestone, timestamp, location, remarks }]
  containerOrWaybillNumber String?
  driverOrVesselInfo      String?
  totalWeightKg           Decimal?           @db.Decimal(10, 2)
  estimatedFreightCost    Decimal?           @db.Decimal(10, 2)
  delayRisk               RiskSeverity       @default(LOW)
  delayReason             String?
  routeNotes              String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([shipmentTrackingNumber])
  @@index([poId])
  @@index([vendorId])
  @@index([currentMilestone])
  @@index([estimatedArrivalDate])
}

model SupplyRiskLog {
  id                        String        @id @default(uuid())
  riskRefNumber             String        @unique // e.g. 'RISK-2026-018'
  vendorId                  String?
  vendor                    VendorDirectory? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  itemSku                   String?
  riskCategory              RiskCategory  @default(LOGISTICS_DISRUPTION)
  severityLevel             RiskSeverity  @default(MEDIUM)
  likelihood                String        @default("POSSIBLE") // REMOTE, POSSIBLE, LIKELY, ALMOST_CERTAIN
  impactDescription         String
  mitigationPlan            String
  status                    RiskStatus    @default(IDENTIFIED)
  owner                     String
  estimatedFinancialExposure Decimal      @default(0.0) @db.Decimal(14, 2)
  reportedAt                DateTime      @default(now())
  resolvedAt                DateTime?

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([riskRefNumber])
  @@index([vendorId])
  @@index([riskCategory])
  @@index([severityLevel])
  @@index([status])
}

// ==================== FIELD SERVICE MANAGEMENT MODULE ====================

enum ServiceRequestType {
  BREAKDOWN_REPAIR
  PREVENTIVE_MAINTENANCE
  INSTALLATION_COMMISSIONING
  WARRANTY_INSPECTION
  AMC_VISIT
}

enum ServicePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL_DOWN
}

enum ServiceRequestStatus {
  LOGGED
  ASSIGNED
  IN_TRANSIT
  ON_SITE_DIAGNOSIS
  PARTS_AWAITING
  RESOLVED
  CLOSED
  CANCELLED
}

enum EngineerStatus {
  AVAILABLE
  ON_SITE
  IN_TRANSIT
  ON_LEAVE
  OFF_DUTY
}

enum AMCContractType {
  COMPREHENSIVE
  NON_COMPREHENSIVE
  LABOR_ONLY
}

enum AMCContractStatus {
  ACTIVE
  EXPIRED
  PENDING_RENEWAL
  SUSPENDED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID_MISUSE
  EXTENDED
}

enum ServiceLogType {
  ARRIVAL_CHECKIN
  DIAGNOSTIC_NOTE
  PARTS_REPLACED
  TESTING_COMPLETED
  CUSTOMER_SIGNOFF
  DEPARTURE_CHECKOUT
}

enum FieldPartRequisitionStatus {
  PENDING_APPROVAL
  DISPATCHED_TO_VAN
  INSTALLED_ON_MACHINE
  RETURNED_TO_CENTRAL_STORE
}

model ServiceRequest {
  id                        String               @id @default(uuid())
  ticketNumber              String               @unique // e.g. 'SR-2026-0814'
  customerName              String
  customerPhone             String
  customerEmail             String?
  serviceLocation           String
  city                      String
  requestType               ServiceRequestType   @default(BREAKDOWN_REPAIR)
  priority                  ServicePriority      @default(MEDIUM)
  status                    ServiceRequestStatus @default(LOGGED)
  machineSerialNumber       String?
  machineModel              String
  reportedFault             String
  resolutionSummary         String?
  assignedEngineerId        String?
  assignedEngineer          FieldEngineer?       @relation(fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  amcContractId             String?
  amcContract               AMCContract?         @relation(fields: [amcContractId], references: [id], onDelete: SetNull)
  warrantyRecordId          String?
  warrantyRecord            WarrantyRecord?      @relation(fields: [warrantyRecordId], references: [id], onDelete: SetNull)
  scheduledDate             DateTime
  completedAt               DateTime?
  firstTimeFix              Boolean              @default(false)
  customerSatisfactionScore Int?                 // 1-5 rating scale
  customerFeedback          String?
  totalServiceCost          Decimal              @default(0.0) @db.Decimal(12, 2)

  logs                      ServiceLog[]
  partRequisitions          FieldPartRequisition[]

  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([ticketNumber])
  @@index([assignedEngineerId])
  @@index([status])
  @@index([priority])
  @@index([city])
}

model FieldEngineer {
  id                        String                 @id @default(uuid())
  employeeCode              String                 @unique // e.g. 'ENG-FLD-014'
  fullName                  String
  phone                     String
  email                     String
  operatingTerritoryCity    String
  technicalSpecializations  String[]               // ['HYDRAULICS', 'ELECTRICAL', 'CNC_SERVO']
  currentStatus             EngineerStatus         @default(AVAILABLE)
  currentLatitude           Decimal?               @db.Decimal(10, 7)
  currentLongitude          Decimal?               @db.Decimal(10, 7)
  lastLocationUpdate        DateTime?
  totalCompletedJobs        Int                    @default(0)
  avgResolutionHours        Decimal                @default(3.2) @db.Decimal(4, 2)
  ftfrRate                  Decimal                @default(94.5) @db.Decimal(5, 2) // First-Time Fix Rate %
  customerRatingAvg         Decimal                @default(4.8) @db.Decimal(3, 2)
  isActive                  Boolean                @default(true)

  assignedRequests          ServiceRequest[]
  vanStocks                 VanStock[]
  partRequisitions          FieldPartRequisition[]
  serviceLogs               ServiceLog[]

  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([employeeCode])
  @@index([operatingTerritoryCity])
  @@index([currentStatus])
}

model AMCContract {
  id                   String            @id @default(uuid())
  contractNumber       String            @unique // e.g. 'AMC-2026-0092'
  customerName         String
  customerContact      String
  machineModel         String
  machineSerialNumber  String
  contractType         AMCContractType   @default(COMPREHENSIVE)
  status               AMCContractStatus @default(ACTIVE)
  startDate            DateTime
  endDate              DateTime
  contractValue        Decimal           @db.Decimal(12, 2)
  visitsAllowedTotal   Int               @default(4)
  visitsConsumed       Int               @default(0)
  termsAndConditions   String?

  serviceRequests      ServiceRequest[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([contractNumber])
  @@index([status])
  @@index([machineSerialNumber])
}

model WarrantyRecord {
  id                   String         @id @default(uuid())
  warrantyCardNumber   String         @unique // e.g. 'WAR-2026-0418'
  customerName         String
  machineModel         String
  machineSerialNumber  String         @unique
  dispatchDate         DateTime
  installationDate     DateTime
  warrantyEndDate      DateTime
  status               WarrantyStatus @default(ACTIVE)
  coverageScope        String         @default("Standard 24-Month Comprehensive OEM Warranty")

  serviceRequests      ServiceRequest[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([warrantyCardNumber])
  @@index([machineSerialNumber])
  @@index([status])
}

model VanStock {
  id                   String        @id @default(uuid())
  engineerId           String
  engineer             FieldEngineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  itemSku              String
  itemName             String
  quantityOnHand       Int           @default(0)
  minimumThreshold     Int           @default(2)
  unitValue            Decimal       @db.Decimal(10, 2)
  binOrCrateLocation   String?
  lastReplenishedAt    DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([engineerId, itemSku])
  @@index([engineerId])
  @@index([itemSku])
}

model ServiceLog {
  id                   String         @id @default(uuid())
  requestId            String
  request              ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  engineerId           String
  engineer             FieldEngineer  @relation(fields: [engineerId], references: [id], onDelete: Restrict)
  timestamp            DateTime       @default(now())
  logType              ServiceLogType @default(DIAGNOSTIC_NOTE)
  locationCoordinates  String?
  notes                String
  partsReplacedJson    Json?          // [{ itemSku, itemName, quantity, serialNumber }]

  createdAt            DateTime       @default(now())

  @@index([requestId])
  @@index([engineerId])
}

model FieldPartRequisition {
  id                         String                     @id @default(uuid())
  requisitionNumber          String                     @unique // e.g. 'FPR-2026-0312'
  requestId                  String
  request                    ServiceRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  engineerId                 String
  engineer                   FieldEngineer              @relation(fields: [engineerId], references: [id], onDelete: Restrict)
  itemSku                    String
  itemName                   String
  quantityRequested          Int
  isDefectiveReturned        Boolean                    @default(false)
  defectivePartSerialNumber  String?
  status                     FieldPartRequisitionStatus @default(PENDING_APPROVAL)
  approvedBy                 String?

  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@index([requisitionNumber])
  @@index([requestId])
  @@index([engineerId])
  @@index([status])
}

// ==================== PURCHASING & MATERIAL SOURCING (PROCUREMENT) MODULE ====================

enum RFQStatus {
  DRAFT
  PUBLISHED
  EVALUATION
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  COUNTER_OFFERED
}

enum ProcurementPOStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  ACKNOWLEDGED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  FULFILLED
  CANCELLED
}

enum ContractTermStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model RequestForQuotation {
  id                   String                   @id @default(uuid())
  rfqNumber            String                   @unique // e.g. 'RFQ-2026-0042'
  title                String
  description          String?
  requisitionId        String?
  requisition          PurchaseRequisition?     @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  status               RFQStatus                @default(DRAFT)
  deadlineDate         DateTime
  targetDeliveryDate   DateTime
  paymentTerms         String                   @default("NET_30")
  deliveryTerms        String                   @default("FOB Plant MIDC")
  items                Json                     // [{ itemSku, itemName, requiredQty, uom, targetPrice, technicalSpecs }]
  invitedVendorsJson   Json?                    // [{ vendorId, vendorName, email, contactedAt }]
  createdBy            String

  bids                 SupplierBid[]
  procurementOrders    PurchaseOrderProcurement[]

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([rfqNumber])
  @@index([status])
  @@index([requisitionId])
  @@index([deadlineDate])
}

model SupplierBid {
  id                   String                   @id @default(uuid())
  rfqId                String
  rfq                  RequestForQuotation      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId             String?
  vendorName           String
  vendorEmail          String
  vendorPhone          String
  bidAmountTotal       Decimal                  @db.Decimal(14, 2)
  quotedItems          Json                     // [{ itemSku, itemName, offeredQty, unitPrice, lineTotal, leadTimeDays, complianceNotes }]
  paymentTermsOffered  String                   @default("NET_30")
  validUntilDate       DateTime
  status               BidStatus                @default(SUBMITTED)
  evaluationScore      Decimal?                 @db.Decimal(5, 2) // Composite score e.g. 94.5%
  negotiationNotes     String?

  procurementOrders    PurchaseOrderProcurement[]

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([rfqId])
  @@index([status])
  @@index([vendorName])
}

model PurchaseOrderProcurement {
  id                     String                 @id @default(uuid())
  poNumber               String                 @unique // e.g. 'PO-PROC-2026-0158'
  requisitionId          String?
  requisition            PurchaseRequisition?   @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  rfqId                  String?
  rfq                    RequestForQuotation?   @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  supplierBidId          String?
  supplierBid            SupplierBid?           @relation(fields: [supplierBidId], references: [id], onDelete: SetNull)
  vendorId               String?
  vendorName             String
  vendorEmail            String
  vendorPhone            String
  vendorAddress          String
  orderDate              DateTime               @default(now())
  promisedDeliveryDate   DateTime
  actualDeliveryDate     DateTime?
  status                 ProcurementPOStatus    @default(DRAFT)
  currency               String                 @default("USD")
  subtotal               Decimal                @db.Decimal(14, 2)
  taxAmount              Decimal                @default(0.0) @db.Decimal(12, 2)
  discountAmount         Decimal                @default(0.0) @db.Decimal(12, 2)
  totalAmount            Decimal                @db.Decimal(14, 2)
  paymentTerms           String                 @default("NET_30")
  deliveryAddress        String                 @default("Central Raw Material Stores, Plant #1, MIDC Chakan, Pune")
  items                  Json                   // [{ itemSku, itemName, orderedQty, receivedQty, unitPrice, discountPct, lineTotal, targetDate }]
  approvedBy             String?
  approvedAt             DateTime?
  issuedBy               String
  remindersSentCount     Int                    @default(0)
  lastReminderSentAt     DateTime?
  modificationsHistory   Json?                  // [{ modifiedAt, modifiedBy, reason, previousSnapshot }]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([poNumber])
  @@index([requisitionId])
  @@index([rfqId])
  @@index([status])
  @@index([promisedDeliveryDate])
}

model MaterialCatalog {
  id                     String                 @id @default(uuid())
  itemSku                String                 @unique // e.g. 'RAW-STL-304-ROD'
  itemName               String
  category               String
  description            String?
  uom                    String                 @default("PCS")
  basePrice              Decimal                @db.Decimal(10, 2)
  currency               String                 @default("USD")
  standardLeadTimeDays   Int                    @default(7)
  minimumOrderQty        Int                    @default(1)
  volumeDiscountTiers    Json                   // [{ minQty, maxQty, discountPct, effectiveUnitPrice }]
  approvedVendorsJson    Json                   // [{ vendorId, vendorName, vendorSku, rank, preferredTier }]
  specificationsJson     Json?                  // Technical specifications & tolerance data
  isActive               Boolean                @default(true)

  contractTerms          VendorContractTerms[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([itemSku])
  @@index([category])
  @@index([isActive])
}

model VendorContractTerms {
  id                     String                 @id @default(uuid())
  contractRefNumber      String                 @unique // e.g. 'VCON-2026-0034'
  vendorId               String
  vendorName             String
  materialCatalogId      String?
  materialCatalog        MaterialCatalog?       @relation(fields: [materialCatalogId], references: [id], onDelete: SetNull)
  contractTitle          String
  fixedPeriodStart       DateTime
  fixedPeriodEnd         DateTime
  agreedUnitPrice        Decimal                @db.Decimal(10, 2)
  priceLockValidUntil    DateTime
  rebateTerms            String?
  minimumAnnualCommitment Decimal?              @db.Decimal(14, 2)
  paymentTerms           String                 @default("NET_30")
  penaltyClauses         String?
  status                 ContractTermStatus     @default(ACTIVE)
  signedByVendor         Boolean                @default(true)

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([contractRefNumber])
  @@index([vendorId])
  @@index([materialCatalogId])
  @@index([status])
}

// ==================== CUSTOMER RELATIONSHIP MANAGEMENT (CRM) MODULE ====================

enum LeadSource {
  INBOUND_WEB
  TRADE_SHOW
  REFERRAL
  COLD_OUTREACH
  PARTNER
  EXISTING_CLIENT
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PipelineStage {
  DISCOVERY
  TECHNICAL_EVALUATION
  QUOTATION_SUBMITTED
  COMMERCIAL_NEGOTIATION
  CONTRACT_REVIEW
  CLOSED_WON
  CLOSED_LOST
}

enum QuotationStatus {
  DRAFT
  PENDING_INTERNAL_REVIEW
  TRANSMITTED_TO_CLIENT
  REVISED
  ACCEPTED
  DECLINED
}

enum SalesOrderCRMStatus {
  DRAFT
  CONFIRMED
  SCHEDULED_FOR_PRODUCTION
  IN_PRODUCTION
  DISPATCH_READY
  FULFILLED
  CANCELLED
}

enum ClientContractCRMStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
  TERMINATED
}

enum InquiryCategory {
  ORDER_STATUS
  TECHNICAL_SPECIFICATION
  DRAWING_REVISION
  EXPEDITED_DELIVERY
  BILLING_QUERY
  QUALITY_CONCERN
}

enum InquiryStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum FeedbackSentiment {
  EXCELLENT
  SATISFIED
  NEUTRAL
  DISSATISFIED
  ESCALATED
}

model ClientDirectory {
  id                   String                 @id @default(uuid())
  clientCode           String                 @unique // e.g. 'CLI-IND-0042'
  companyName          String
  industry             String                 // e.g. 'Automotive Tier-1', 'Heavy Equipment', 'Aerospace Precision'
  primaryContactName   String
  email                String
  phone                String
  billingAddress       String
  city                 String
  state                String
  country              String                 @default("India")
  taxGstin             String?
  creditLimit          Decimal                @default(50000.0) @db.Decimal(14, 2)
  paymentTerms         String                 @default("NET_30")
  totalLifetimeSpend   Decimal                @default(0.0) @db.Decimal(14, 2)
  accountManager       String
  isActive             Boolean                @default(true)

  leads                Lead[]
  quotations           Quotation[]
  salesOrders          SalesOrderCRM[]
  contracts            ClientContractCRM[]
  inquiries            CustomerInquiry[]
  feedbacks            CustomerFeedback[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([clientCode])
  @@index([companyName])
  @@index([industry])
  @@index([isActive])
}

model Lead {
  id                          String             @id @default(uuid())
  leadNumber                  String             @unique // e.g. 'LEAD-2026-0182'
  title                       String             // e.g. 'Hydraulic Cylinders 500-unit Batch Run'
  clientId                    String?
  client                      ClientDirectory?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyName                 String
  contactPerson               String
  email                       String
  phone                       String
  source                      LeadSource         @default(INBOUND_WEB)
  priority                    LeadPriority       @default(MEDIUM)
  stage                       PipelineStage      @default(DISCOVERY)
  estimatedValue              Decimal            @db.Decimal(14, 2)
  expectedCloseDate           DateTime
  assignedSalesRep            String
  technicalRequirementSummary String
  notes                       Json?              // [{ timestamp, author, noteText }]

  quotations                  Quotation[]
  salesOrders                 SalesOrderCRM[]

  campaignId                  String?
  campaign                    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@index([leadNumber])
  @@index([clientId])
  @@index([campaignId])
  @@index([stage])
  @@index([priority])
  @@index([assignedSalesRep])
}

model SalesPipelineStage {
  id                  String             @id @default(uuid())
  stageKey            PipelineStage      @unique
  stageName           String
  stageOrder          Int
  winProbabilityPct   Int                @default(10)
  description         String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Quotation {
  id                      String             @id @default(uuid())
  quotationNumber         String             @unique // e.g. 'QT-2026-0312'
  revisionNumber          Int                @default(1)
  leadId                  String?
  lead                    Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId                String?
  client                  ClientDirectory?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName              String
  clientEmail             String
  status                  QuotationStatus    @default(DRAFT)
  validUntilDate          DateTime
  paymentTerms            String             @default("NET_30")
  incoterms               String             @default("FOB MIDC Chakan")
  currency                String             @default("USD")
  subtotal                Decimal            @db.Decimal(14, 2)
  discountAmount          Decimal            @default(0.0) @db.Decimal(12, 2)
  taxAmount               Decimal            @default(0.0) @db.Decimal(12, 2)
  totalAmount             Decimal            @db.Decimal(14, 2)
  manufacturingCostBasis  Json               // [{ itemSku, itemName, rawMaterialCost, machineHours, laborCost, overheadCost, marginPct, unitPrice, qty, lineTotal }]
  lineItems               Json               // [{ itemSku, itemName, quantity, uom, unitPrice, lineTotal, technicalDrawingRef }]
  preparedBy              String
  approvedBy              String?
  revisionsHistory        Json?              // [{ revisionNumber, revisedAt, revisedBy, reason, previousTotal }]

  salesOrders             SalesOrderCRM[]

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([quotationNumber])
  @@index([leadId])
  @@index([clientId])
  @@index([status])
}

model SalesOrderCRM {
  id                        String              @id @default(uuid())
  orderNumber               String              @unique // e.g. 'SO-CRM-2026-0142'
  leadId                    String?
  lead                      Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotationId               String?
  quotation                 Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  clientId                  String
  client                    ClientDirectory     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientPoNumber            String              // e.g. 'CPO-AUTO-9982'
  orderDate                 DateTime            @default(now())
  targetDeliveryDate        DateTime
  status                    SalesOrderCRMStatus @default(CONFIRMED)
  currency                  String              @default("USD")
  totalAmount               Decimal             @db.Decimal(14, 2)
  lineItems                 Json                // [{ itemSku, itemName, orderedQty, unitPrice, lineTotal, productionBatchScheduleId }]
  productionScheduleLinked  Boolean             @default(true)
  productionWorkOrderRef    String?             // e.g. 'WO-2026-0881'
  shippingAddress           String
  salesRep                  String

  inquiries                 CustomerInquiry[]

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([orderNumber])
  @@index([clientId])
  @@index([leadId])
  @@index([quotationId])
  @@index([status])
  @@index([targetDeliveryDate])
}

model ClientContractCRM {
  id                      String                  @id @default(uuid())
  contractRefNumber       String                  @unique // e.g. 'CCON-2026-0018'
  clientId                String
  client                  ClientDirectory         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractTitle           String
  contractType            String                  @default("Master Manufacturing Supply Agreement")
  startDate               DateTime
  endDate                 DateTime
  committedAnnualRevenue  Decimal                 @db.Decimal(14, 2)
  rateCardJson            Json                    // [{ itemSku, lockedUnitPrice, minAnnualQty }]
  penaltyTerms            String?
  status                  ClientContractCRMStatus @default(ACTIVE)
  signedByClient          Boolean                 @default(true)
  accountManager          String

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([contractRefNumber])
  @@index([clientId])
  @@index([status])
}

model CustomerInquiry {
  id                 String              @id @default(uuid())
  ticketNumber       String              @unique // e.g. 'INQ-2026-0412'
  clientId           String
  client             ClientDirectory     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesOrderId       String?
  salesOrder         SalesOrderCRM?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  category           InquiryCategory     @default(ORDER_STATUS)
  subject            String
  description        String
  priority           LeadPriority        @default(MEDIUM)
  status             InquiryStatus       @default(OPEN)
  assignedAgent      String
  resolutionNotes    String?
  resolvedAt         DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([ticketNumber])
  @@index([clientId])
  @@index([salesOrderId])
  @@index([status])
  @@index([category])
}

model CustomerFeedback {
  id                  String             @id @default(uuid())
  feedbackNumber      String             @unique // e.g. 'FB-2026-0091'
  clientId            String
  client              ClientDirectory    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sentiment           FeedbackSentiment  @default(SATISFIED)
  npsScore            Int                @default(9) // 1 to 10
  deliveryRating      Int                @default(5) // 1 to 5
  qualityRating       Int                @default(5) // 1 to 5
  communicationRating Int                @default(5) // 1 to 5
  feedbackComments    String
  orderReference      String?
  actionTaken         String?

  createdAt           DateTime           @default(now())

  @@index([feedbackNumber])
  @@index([clientId])
  @@index([sentiment])
}

// ==================== DEPARTMENT-WISE WORKFORCE & SHOP-FLOOR DEPLOYMENT MODELS ====================

enum WorkstationRole {
