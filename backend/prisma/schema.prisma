  TRANSIT_DAMAGE_LOGGED
  VEHICLE_GATE_ENTRY
  VEHICLE_GATE_EXIT
  INBOUND_TRANSPORT_VERIFIED
  OUTBOUND_GATE_CLEARED
  DELIVERY_TRIP_UPDATED
  SPECIAL_GATE_PASS_ISSUED
  SPECIAL_GATE_PASS_RETURNED
  EMPLOYEE_CREATED
